<body>

<div type="edition" n="urn:cts:greekLit:tlg4110.cllg001.sc-cllg-grc1" xml:lang="grc">
  <pb ed="SC" n="487"/>
  <div type="textpart" subtype="chunk" n="1">
    <head xml:lang="la"><lb n="1"/>Ad Prov. 30, 24-28</head>
    <div type="textpart" subtype="item" n="1">
      <p><lb n="2"/>Μύρμηξ ἐστὶν ἄνθρωπος πρακτικὸς τὴν ἑαυτοῦ τροφὴν ἐν τῷ
        <lb n="3"/>αἰῶνι τούτῳ παρασκευάζων.</p>
    </div>
    <div type="textpart" subtype="item" n="2">
      <p><lb n="4"/>Χοιρογρύλλιοί εἰσιν ἔθνη ἀκάθαρτα τὰς ἐντολὰς δεξάμενα τοῦ
        <lb n="5"/>σωτῆρος ἡμῶν Χριστοῦ.</p>
    </div>
    <div type="textpart" subtype="item" n="3">
      <p><lb n="6"/>Ἀβασίλευτοι ἀκρίδες εἰσὶ ψυχαὶ λογικαὶ μὴ βασιλευόμεναι ὑπὸ
        <lb n="7"/>τοῦ θανάτου καὶ ὑπὸ τῶν τοῦ θεοῦ σπερμάτων διατρεφόμεναι.</p>
    </div>
    <div type="textpart" subtype="item" n="4">
      <p><lb n="8"/>Ἀσκαλαβώτης ἐστὶ νοῦς πρακτικὸς ἐπερειδόμενος ἀρεταῖς καὶ
        <lb n="9"/>κατοικῶν ἐν ταῖς γνώσεσι τῶν οὐρανίων δυνάμεων.</p>
    </div>
  </div>
  <div type="textpart" subtype="chunk" n="2">
    <head xml:lang="la"><lb n="10"/>Ad Prov. 30, 29-31</head>
    <div type="textpart" subtype="item" n="5">
      <p><lb n="11"/>Σκύμνος λέοντός ἐστιν ἄνθρωπος ἀπαθὴς τῶν ἐν αὐτῷ γενομένων
        <lb n="12"/>βασιλεύσας θηρίων.</p>
    </div>
    <div type="textpart" subtype="item" n="6">
      <p><lb n="13"/>Ἀλεκτρύων ἐστιν ἄνθρωπος πνευματικὸς πληρούμενος γνώσεως
        <lb n="14"/>καὶ ἑτέραις εὐαγγελιζόμενος ψυχαῖς τὴν παρὰ τοῦ νοητοῦ ἡλίου
        <lb n="15"/>γενομένην ἡμέραν.</p>
    </div>
    <pb ed="SC" n="488"/>
    <div type="textpart" subtype="item" n="7">
      <p><lb n="1"/>Τράγος ἐστὶν ἀνὴρ πρακτικὸς τῶν ἐν αὐτῷ ἀτάκτων λογισμῶν
        <lb n="2"/>ὀρθῶς καθηγούμενος.</p>
    </div>
    <div type="textpart" subtype="item" n="8">
      <p><lb n="3"/>Βασιλεύς ἐστιν ἄνθρωπος καταξιωθεὶς τῆς βασιλείας τῶν
        <lb n="4"/>οὐρανῶν διδάσκειν ἑτέρους πεπαιδευμένος.</p>
    </div>
  </div>
  <div type="textpart" subtype="chunk" n="3">
    <head xml:lang="la"><lb n="5"/>Ad Prov. 30, 15-16</head>
    <div type="textpart" subtype="item" n="9">
      <p><lb n="6"/>Βδέλλα ἐστὶ φύσις ἀκάθαρτος τὸ δίκαιον αἷμα ἐκ τῶν λογικῶν
        <lb n="7"/>ψυχῶν ἐκμυζῶσα.</p>
    </div>
    <div type="textpart" subtype="item" n="10">
      <p><lb n="8"/>ᾍδης ἐστὶν ἄγνοια φύσεως λογικῆς κατὰ στέρησιν τῆς τοῦ θεοῦ
        <lb n="9"/>θεωρίας ἐπισυμβαίνουσα.</p>
    </div>
    <div type="textpart" subtype="item" n="11">
      <p><lb n="10"/>Γυνή ἐστιν ἀφροσύνη λογικὰς ψυχὰς ἐπὶ ἀκαθαρσίαν προσκα<lb n="11" break="no"/>λουμένη.</p>
    </div>
    <div type="textpart" subtype="item" n="12">
      <p><lb n="12"/>Γῆ ἐστιν ἕξις χειρίστη ἐξ ἀσεβείας καὶ παρανομίας συλλεγομένη.
        <lb n="13"/>La « terre », c'est l'état mauvais composé de l'impiété et de
        <lb n="14"/>l'iniquité.</p>
    </div>
    <div type="textpart" subtype="item" n="13">
      <p><lb n="15"/>Πῦρ ἐστι κακία φύσεως λογικῆς φθαρτικὴ τῶν τοῦ θεοῦ
        <lb n="16"/>ἀρετῶν.</p>
    </div>
    <div type="textpart" subtype="item" n="14">
      <p><lb n="17"/>Ὕδωρ ἐστὶ γνῶσις ψευδὴς σβεστικὴ γνώσεως ἀληθοῦς.</p>
    </div>
  </div>
  <div type="textpart" subtype="chunk" n="4">
    <head xml:lang="la"><lb n="18"/>Ad Prov. 30, 17</head>
    <div type="textpart" subtype="item" n="15">
      <p><lb n="19"/>Ὀφθαλμὸς καταγελῶν ἐστι φύσις ἀκαθαρτος τῆς τοῦ θεοῦ
        <lb n="20"/>καταγελῶσα γνώσεως καὶ ἀτιμάζουσα τὴν ἐν τοῖς γεγονόσι σοφίαν.</p>
    </div>
    <pb ed="SC" n="489"/>
    <div type="textpart" subtype="item" n="16">
      <p><lb n="1"/>Κόρακές εἰσι δυνάμεις ἅγιαι φθαρτικαὶ τῶν κακιῶν.</p>
    </div>
    <div type="textpart" subtype="item" n="17">
      <p><lb n="2"/>Φάραγγές εἰσι ψυχαὶ λογικαὶ κοιλανθεῖσαι ἀπὸ κακίας καὶ
        <lb n="3"/>ἀγνωσίας.</p>
    </div>
    <div type="textpart" subtype="item" n="18">
      <p><lb n="4"/>Νεοσσοὶ ἀετῶν εἰσι δυνάμεις ἅγιαι τοὺς ἀκαθάρτους καταβάλ<lb n="5" break="no"/>λειν πεπιστευμέναι.</p>
    </div>
  </div>
</div>
</body>
