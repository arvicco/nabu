<app from="#beg0929019" to="#end0929019"><lem wit="#wit.orig">頂禮<lb n="0929b09" ed="T"/>十方一切三寶<note n="0929020" resp="#resp2" type="orig" place="foot text">〔一拜〕－【甲】【乙】</note><note n="0929020" resp="#resp1" type="mod">一拜【大】，〔－〕【甲】【乙】</note><app n="0929020"><lem wit="#wit.orig"><note place="inline">一拜</note></lem><rdg resp="#resp2" wit="#wit2 #wit3"><space quantity="0"/></rdg></app></lem><rdg resp="#resp2" wit="#wit2">歸依世間大慈悲父</rdg></app>
