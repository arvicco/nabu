  <text xml:lang="pra-Latn">
    <body>
      <pb n="1"/>
      <head xml:lang="pra-Latn">kaïrāa-bappaïrāassa</head>
      <head xml:lang="san-Latn">kavirāja-vākpatirājasya</head>
      <head xml:lang="pra-Latn">gauḍavahō</head>
      <head xml:lang="san-Latn">gauḍavadham</head>
      <label xml:lang="san-Latn">maṅgalācaraṇam</label>
      <lg met="āryā" n="1">
        <l>paḍhamaṁ cia dhavala-kaōvavīamamburuha-gōaraṁ ṇamaha</l>
	<l>hari-jaḍhara-ṇiggamukkhitta-ṇāla-suttaṁ piva sayambhuṁ</l>
        <note type="chāyā">
	  <lg xml:lang="san-Latn" n="1">
	    <l>prathamamēva dhavalakr̥tōpavītamamburuhagōcaraṁ namata</l>
	    <l>harijaṭharanirgamōtkṣiptanālasūtramiva svayaṁbhuvam</l>
	  </lg>
	</note>
      </lg>
      <lg met="āryā" n="2">
        <l>sō jaaï kaṇṇiā-valaa-gabbha-parigūḍha-viaḍa-bīammi</l>
	<l>jō vasaï ṇihāṇīkaa-bahu-bambhaṇḍe vva kamalammi</l>
        <note type="chāyā">
	  <lg xml:lang="san-Latn" n="2">
	    <l>sa jayati karṇikāvalayagarbhaparigūḍhavikaṭabījē</l>
	    <l>yō vasati nidhānīkr̥tabahubrahmāṇḍa iva kamalē</l>
	  </lg>
	</note>
      </lg>
      <lg met="āryā" n="3">
        <l>taṁ paṇamaha tiṅgicchi-cchalēṇa ṇivasaï ṇivēsa-kamalammi</l>
	<l>jassa paramāṇu-ṇivaho vva bhuvaṇa-ṇimmāṇa-paḍivaṇṇō</l>
        <note type="chāyā">
	  <lg xml:lang="san-Latn" n="3">
	    <l>taṁ praṇamata padmarajaśchalēna nivasati nivēśakamalē</l>
	    <l>yasya paramāṇunivaha iva bhuvananirmāṇapratipannaḥ</l>
	  </lg>
	</note>
      </lg>
      <lg met="āryā" n="108">
	<l>jassa a valanta-jaa-gaa-sīara-dhārā-sahassa-luliāō</l>
	<l>sambhama-sañcāria-cāmarāo dhāvanti va disāō</l>
        <note type="chāyā">
          <lg xml:lang="san-Latn" n="108">
	    <l>yasya ca valamānajayagajaśīkaradhārāsahasralulitāḥ</l>
	    <l>saṁbhramasaṁcāritacāmarā dhāvantīva diśaḥ</l>
	  </lg>
	</note>
      </lg>
      <p>
	<s>avi a—</s>
	<note type="chāyā">
	  <p xml:lang="san-Latn">
	    <s>api ca—</s>
	  </p>
	</note>
      </p>
      <lg met="āryā" n="109">
	<l>sōhaï viṇivēsia-pasiḍhilaṅgulī-kōḍi-<app><lem>kaṭṭha</lem><rdg>ghaṭṭa</rdg></app>ṇutthallō</l>
	<l>pāaḍiabbhantara-vaṇa-ṇivēsa-dara-danturō aharō</l>
        <note type="chāyā">
          <lg xml:lang="san-Latn" n="109">
	    <l>śōbhatē vinivēśitapraśithilāṅgulīkōṭikarṣaṇōcchalitaḥ</l>
	    <l>prakaṭitābhyantaravraṇanivēśēṣaddaṁturō ’dharaḥ</l>
	  </lg>
	</note>
      </lg>
      <trailer>
	kaïrāa-lañchaṇassa vappaïrāassa gauḍavahē gāhāvīḍhaṁ samattaṁ<note type="chāyā">
	  <ab xml:lang="san-Latn">kavirājalāñchanasya vākpatirājasya gauḍavadhē gāthāpīṭhaṁ samāptam</ab>
	</note>
      </trailer>
    </body>
  </text>
