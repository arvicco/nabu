					<bibl><ptr target="bib:Blagden1913-1914_01"/><citedRange>127 (6)</citedRange></bibl>
					<bibl><ptr target="bib:ASB"/><citedRange>1916, 18 (with n. ‡), 20, 55</citedRange></bibl>
					<bibl><ptr target="bib:ASB"/><citedRange>1917, 24-5</citedRange></bibl>
					<bibl><ptr target="bib:ASB"/><citedRange>1922, 17</citedRange></bibl>
				</listBibl>
