                <div type="topic">
                    <entry xml:id="p071.1">
                        <sense xml:lang="san-Latn">śrīvatsasvastikanandyāvartalalitapāṇipādaḥ</sense>
                        <sense xml:lang="bod-Tibt"/>
                        <sense xml:lang="mnc-Latn">gale bethe de horonggo jijun bime hūturingga temgetu enteheme to-ronggo(sic) i yongkiyaha</sense>
                        <sense xml:lang="mon-Latn">gar khöl inu chag un jirukhai khiged ölzei tu tamag a ber belgedegsen</sense>
                        <sense xml:lang="zho-Hant">手足胸臆吉祥德相妙好具足</sense>
                    </entry>
                </div>
                <div type="topic">
                    <entry xml:id="p086.1">
                        <sense xml:lang="san-Latn">[bodhisattvanāmāni]</sense>
                        <sense xml:lang="bod-Tibt"/>
                        <sense xml:lang="mnc-Latn">fusa (BN fusa i) gebu</sense>
                        <sense xml:lang="mon-Latn">bodisadu iin nere inu</sense>
                        <sense xml:lang="zho-Hant">菩薩通號名</sense>
                    </entry>
                </div>
                <div type="topic">
                    <div type="topic">
                        <entry xml:id="p155.1">
                            <sense xml:lang="san-Latn">[catvāri smṛtyupasthānāni]</sense>
                            <sense xml:lang="bod-Tibt"/>
                            <sense xml:lang="mnc-Latn">gūsin nadan hacin bodi jugūn i nomun dorgi (BN dorgi i)duin jondon be kiceme tebure                                                                                                  gebu</sense>
                            <sense xml:lang="mon-Latn">bodi züg un guchin dologon nom asa dörben doradakhui üir e agulkhui iin ner e inu</sense>
                            <sense xml:lang="zho-Hant">三十七助道品內四念處名</sense>
                        </entry>
                    </div>
                    <div type="topic">
                        <entry xml:id="p166.2">
                            <sense xml:lang="san-Latn">catvāra ṛddhipādāḥ</sense>
                            <sense xml:lang="bod-Tibt"/>
                            <sense xml:lang="mnc-Latn">cihalan i samadi</sense>
                            <sense xml:lang="mon-Latn">durashikhui iin samadi</sense>
                            <sense xml:lang="zho-Hant"/>
                        </entry>
                    </div>
                </div>
                <!-- end bodhi pAks.ika  -->
