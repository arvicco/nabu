{"ochre":{"uuidBelongsTo":"46ccab46-9c3f-4448-8476-2bf18236791e","publicationDateTime":"2019-03-08T01:40:57","text":{"project":{"identification":{"alias":{"language":"fre","content":"Ras Shamra Témoignages et Informatiques"},"label":"Ras Shamra Tablet Inventory","abbreviation":"RSTI"},"publicationDateTime":"2017-04-15T23:44:57"},"description":"Hittite decree regarding ḫapiru","language":"Akkadian","availability":{"license":"All object information derived from Bordreuil and Pardee (1989) La Trouvaille Épigraphique de l\u2019Ougarit 1: Concordance. Ras Shamra-Ougarit 5, Éditions Recherche sur les Civilisations: Paris, with additions and corrections. Text editions are attributed to the editors. Photos are copyright of PhoTEO, MRS."},"type":"logosyllabic","uuid":"39ba4c2f-6d82-4b6c-a13b-6ded30136c42","n":0,"sections":{"graphemic":{"section":[{"identification":{"label":"Recto"},"section":[{"identification":{"label":1},"type":"line","value":{"i":"ta ba ar na","content":"KIŠIB","sup":"NA\u2084"}},{"identification":{"label":2},"type":"line","value":{"i":"ḫa at tu ši li","content":"LUGAL GAL"}},{"identification":{"label":3},"type":"line","value":{"i":["šum ma","ú ga ri it"],"content":"ARAD LUGAL KUR"}},{"identification":{"label":4},"type":"line","value":{"i":["ù lu ú","ú ga ri it"],"content":"DUMU KUR"}},{"identification":{"label":5},"type":"line","value":{"i":["lu ú","ú ga ri it"],"content":"ARAD ARAD LUGAL KUR"}},{"identification":{"label":6},"type":"line","value":{"i":"ma am ma i te eb bi ma"}},{"identification":{"label":7},"type":"line","value":{"i":["a na","ir ru ub"],"content":["ŠÀ","A ŠÀ","SA GAZ","UTU"],"sup":[{"i":"bi"},"LÚ","d",{"i":"ši"}]}},{"identification":{"label":8},"type":"line","value":{"i":["ú ul a la aq qí","šu"],"content":["LUGAL GAL","[","]"]}},{"identification":{"label":9},"type":"line","value":{"i":["a na","ú ga ri it"],"content":"LUGAL KUR"}},{"identification":{"label":10},"type":"line","value":{"i":"ú ta ar šu"}},{"qualities":{"condition":{"separatorLength":40,"separatorStyle":"single"}},"type":"separator","value":"----------------------------------------"},{"identification":{"label":11},"type":"line","value":{"i":["šum ma","ú ga ri it"],"content":["DUMU","KUR"],"sup":"MEŠ"}},{"identification":{"label":12},"type":"line","value":{"i":["ša","ti ša ni ti"],"content":"KUR"}},{"identification":{"label":13},"type":"line","value":{"i":["i na","šu nu i pa aš ša ru"],"content":"KÙ BABBAR"}},{"identification":{"label":14},"type":"line","value":{"i":["iš tu","ú ga ri it"],"content":["ŠÀ","KUR"],"sup":{"i":"bi"}}},{"identification":{"label":15},"type":"line","value":{"i":"in na ab bi it ma"}},{"identification":{"label":16},"type":"line","value":{"i":["a na","ir ru ub"],"content":["ŠÀ","SA GAZ"],"sup":{"i":"bi","content":"LÚ"}}},{"identification":{"label":17},"type":"line","value":{"i":"ú ul a la qí šu","content":"LUGAL GAL"}}],"type":"section"},{"identification":{"label":"Verso"},"section":[{"identification":{"label":18},"type":"line","value":{"i":["a na","ú ga ri it"],"content":"LUGAL KUR"}},{"identification":{"label":19},"type":"line","value":{"i":"ú tá ar šu"}}],"type":"section"}]},"translation":{"section":[{"identification":{"label":"Authorization via royal seal"},"section":{"epigraphicReference":"01-02","epigraphicContext":"Recto","translation":"The seal of Tabarna, Ḫattušili the great king.","type":"phrase"},"type":"paragraph"},{"identification":{"label":"First protasis"},"section":[{"identification":{"label":"Casus Pendens with logical subjects 1-3"},"section":{"epigraphicReference":"03-05","epigraphicContext":"Recto","translation":"Whether a subordinate of the king of Ugarit, or someone from the land of Ugarit, or a subordinate of a subordinate of the king of Ugarit--","type":"phrase"},"type":"paragraph"},{"identification":{"label":"Personal indefinite pronoun mamma as grammatical subject of predicates possibly used in verbal hendiadys tebû\u2014erēbu"},"section":{"epigraphicReference":"06-07","epigraphicContext":"Recto","translation":"whoever sets out (and) enters the territory of the ḫāpiru-people of the Sun,","type":"clause"},"type":"paragraph"}],"type":"paragraph"},{"identification":{"label":"First apodosis"},"notes":{"note":{"date":"08/27/2013","noteNo":1,"content":"The phrase šarru rabû ul alaqqīšu contains a change in subject. The topicalized subject (šarru rabû) is followed by a first person verb containing the grammatical subject. The translation attempts to render the nominative absolute apart from the grammatical subject of the verb. The same syntax is found in the second paragraph (line 17).","authors":{"author":{"uuid":"fd35df45-2ee0-4dfd-ac09-d5499932b42d"}}}},"section":{"epigraphicReference":"08-10","epigraphicContext":"Recto","translation":"(as) the great king, I will not accept him. I will return him to the king of Ugarit.","type":"clause"},"type":"paragraph"},{"identification":{"label":"Second protasis"},"section":[{"epigraphicReference":"11-13","epigraphicContext":"Recto","translation":"If the people of land of Ugarit sell someone from another country","type":"clause"},{"epigraphicReference":"14-15","epigraphicContext":"Recto","translation":"(but) he flees from Ugarit (and)","type":"clause"},{"epigraphicReference":16,"epigraphicContext":"Recto","translation":"enters the midst of the ḫāpiru-people,","type":"clause"}],"type":"paragraph"},{"identification":{"label":"Second apodosis"},"section":[{"epigraphicReference":17,"epigraphicContext":"Recto","translation":"(as) the great king, I will not accept him.","type":"clause"},{"epigraphicReference":"18-19","epigraphicContext":"Verso","translation":"I will return him to the king of Ugarit.","type":"sentence"}],"type":"paragraph"}]},"phonemic":{"section":[{"identification":{"label":"Recto"},"section":[{"identification":{"label":1},"type":"line","value":{"i":"kunuk Tabarna"}},{"identification":{"label":2},"type":"line","value":{"i":"Ḫattušili šarri rabî"}},{"identification":{"label":3},"type":"line","value":{"i":"šu