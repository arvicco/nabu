            <div type="edition" xml:lang="tam" rendition="class:tamil maturity:vernacular">
                
                <p>
                    <lb n="1"/>kō-rā<hi rend="grantha">ja</hi>ke<hi rend="grantha">sa</hi>riva<hi rend="grantha">nma</hi>kku yāṇṭu 9 <unclear>Āva</unclear>tu
                </p>
                
                <p>
                    Ār<supplied reason="omitted">k</supplied>kāṭṭu-k-kūṟṟattu <hi rend="grantha">brahmade</hi>yam
                    <lb n="2"/><hi rend="grantha">cantralekhai</hi>-catu<hi rend="grantha">rvve</hi>ti-maṅkalattu peruṅ-kuṟi <hi rend="grantha">sabhai</hi>yōm Ivv-ūr Ai
                    <lb n="3" break="no"/>mpattu mu<choice><orig>n</orig><reg>ṉ</reg></choice>ṟāṅ kuṭumpil <hi rend="grantha">bhā</hi>rata-paṅku kōyilā<choice><orig>n</orig><reg>ṉ</reg></choice> nāka-ṉan=ti viṟṟa paṅku 1
                </p>
                
                <p>
                    I
                    <lb n="4" break="no"/>vv-oru paṅkum Ivv-ūr <hi rend="grantha">brahmasthā</hi>nattu miyceṅkiḷi-nāṭṭu veṇṇāyil-uṭai
                    <lb n="5" break="no"/>yāṉ vayira-<choice><orig>mm</orig><reg>m</reg></choice>ēka<surplus>m</surplus>-paṭāraṉ Eṭuppitta Ampalattu Iruntu nicatiyum <hi rend="grantha">śrī</hi>
                    <lb n="6" break="no"/>-<hi rend="grantha">bhā</hi>ratam vācikka perum-puliyūr Ā<hi rend="grantha">trai</hi>ya-<hi rend="grantha">gottra</hi>ttu vai<hi rend="grantha">khānasa-sūtra</hi>ttu <hi rend="grantha">śi</hi><unclear>ṅki</unclear>
                    <lb n="7" break="no"/><unclear>nan=til</unclear> <hi rend="grantha">śva-rū</hi>pa-<hi rend="grantha">bhaṭṭa</hi>nukku Iṟai-I<choice><orig>ll</orig><reg>l</reg></choice>i-y-āka kuṭuttōm <hi rend="grantha">sabhai</hi>yōm
                </p>
                
                <p>
                    Ivanil-p pi
                    <lb n="8" break="no"/>ṉpu Ip-paṅk’ uṇpār Ivv-ūr <hi rend="grantha">brahmasthā</hi>nattē Iruntu nicatiyum <hi rend="grantha">śrī-bhā</hi>ratam vāci
                    <lb n="9" break="no"/>tt’ uṇpat’ āka Ip-paṅk’ oṉṟum <hi rend="grantha">candrādi</hi>t=tavat Iṟai-Ili-y-āka paṇittu kal mēl
                    
                    <lb n="10"/>veṭṭi kuṭuttō<unclear>m</unclear> peruṅ-kuṟi <hi rend="grantha">sabhai</hi>yōm
                </p>
                
