                        <sic>ו</sic>
                        <corr>ד</corr>
                    </choice>ה ויאמר שנאת ל<persName ref="ancient_persons.xml#p20165">תמת</persName> אנתתי<lb n="8" rend="right-to-left" />כספ שנא בראשה ינתנ ל<persName ref="ancient_persons.xml#p20165">תמת</persName> כספ תקלנ 111 111 1 <add place="above">ר 11</add> וכל זי הנעלת בידה תהנפק מנ חמ<lb n="9" rend="right-to-left" />עד חוט מחר או יומ אחרנ תקמ <persName ref="ancient_persons.xml#p20165">תמת</persName> ותאמר שנאת לבעלי <persName ref="ancient_persons.xml#p20035">ענני</persName> כספ ש<supplied cert="high" evidence="previouseditor" reason="omitted">נ</supplied>אה בראשה<lb n="10" rend="right-to-left" />תנתנ ל<persName ref="ancient_persons.xml#p20035">ענני</persName> כספ שקלנ 111 111 1 <add place="above">ר 11</add> וכל זי הנעלת בידה תהנפק מנ חמ עד חוט מחר או יומ<lb n="11" rend="right-to-left" />אחרנ ימות <persName ref="ancient_persons.xml#p20035">ענניה</persName>
