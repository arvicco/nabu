                     <rdg wit="#Ac #La #Ob #Oc #Od #Ph">ὁμιλία</rdg>
                     <rdg wit="#Gc #Kb #Oa">λόγος</rdg>
                     <rdg wit="#Ad #Be #Ga #Gb #Mb #Mc #Sn #Ve" type="omission"/>
                  </app> εἰς τὸ <quote>ἐν ἀρχῇ ἦν ὁ λόγος <app type="variants">
                        <lem wit="#Ac #Ad #Be #Bs #Ga #Gb #Gc #Kb #La #Mb #Mc #Oa #Ob #Od #Sn"/>
                        <rdg wit="#Oc #Ph" type="addition">καὶ ὁ λόγος ἦν πρὸς τὸν θεὸν καὶ
								θεὸς ἦν ὁ λόγος</rdg>
                        <rdg wit="#Ve" type="addition">καὶ
								θεὸς ἦν ὁ λόγος</rdg>
                        <rdg source="#PG" type="addition">καὶ
								τὰ ἑξῆς</rdg>
                     </app>
                     <ref decls="#biblical" cRef="NA:Jn:1:1"/>
                  </quote> καὶ ὅτι <quote>τὸ πνεῦμα ἐρευνᾷ <app type="variants">
                        <lem wit="#Ac #Ad #Be #Bs #Ga #Gb #La #Mb #Ob #Od #Sn"/>
                        <rdg wit="#Gc #Kb #Mc #Oa #Oc #Ph #Ve" type="addition">καὶ</rdg>
                     </app> τὰ βάθη τοῦ θεοῦ<ref decls="#biblical" cRef="NA:1Cor:2:10"/>
                  </quote>
                  <app type="variants">
                     <lem wit="#Ac #Ad #Be #Bs #Ga #Gb #Gc #Kb #La #Mb #Mc #Oa #Ob #Od #Sn #Ve"/>
                     <rdg wit="#Oc #Ph" type="addition">καὶ
								περὶ τῶν νεοφωτίστων καὶ κατὰ
								αἱρετικῶν</rdg>
                  </app>. <app type="variants">
                     <lem wit="#Ac #Be #Bs #Ga #Gb #La #Mb #Mc #Oa #Ob #Od #Ph #Sn #Ve"/>
                     <rdg wit="#Oc">τῆ αὐτῆ ἡμέρα</rdg>
                     <rdgGrp>
                        <rdg wit="#Gc">ὁ δὲ λόγος
								ἀναγινώσκεται τῆ δευτέρα τῆς
								διακαινησΐμου</rdg>
                        <rdg wit="#Kb">ἀναγϊνώσκεται ὁ λόγος
								τῆ δευτρ’ τῆς διακϊνησίμου</rdg>
                     </rdgGrp>
                  </app>
                  <app type="variants">
                     <lem wit="#Ac #Be #Bs #Ga #Gc #La #Mb #Mc #Oa #Ob #Od #Ph #Sn #Ve"/>
                     <rdg wit="#Kb">περ εὐα’</rdg>
                     <rdg wit="#Oc" type="addition">εὐλογεῖτε
								πατέρι</rdg>
                     <rdg wit="#Gb" type="addition">κύριε
								εὐλόγησον</rdg>
                     <rdg wit="#Ad" type="addition">κύριε</rdg>
                  </app>
               </title>
            </head>
            <div type="textpart" subtype="section" n="1">
               <p>Χθὲς ἡμῖν ὁ λόγος εἰς τὴν τοῦ μεγάλου <app type="variants">
                     <lem wit="#Ac #Ad #Be #Bs #Ga #Gb #Gc #La #Mb #Mc #Oa #Ob #Od #Ph #Sn #Ve">ἀετοῦ θεωρίαν <app type="variants">
                           <lem wit="#Ac #Ad #Bs #Ga #Gb #Gc #La #Mb #Mc #Oa #Ob #Od #Ph #Sn #Ve">κατέληξεν</lem>
                           <rdg wit="#Be">ἔληξεν</rdg>
                        </app>
                     </lem>
                     <rdg wit="#Kb" type="omission" cause="homoiarkton"/>
                  </app>, ἀετοῦ τοῦ <app type="variants">
                     <rdgGrp>
                        <lem wit="#Gc #Oa #Ph #Ve">ὄντως</lem>
                        <rdg wit="#Oc" cause="orthographic">ὄντος</rdg>
                        <rdg wit="#Kb">ὄρτως</rdg>
                     </rdgGrp>
                     <rdg wit="#Ac #Ad #Be #Bs #Ga #Gb #La #Mb #Mc #Ob #Od #Sn" type="omission"/>
                  </app>
                  <app type="variants">
                     <lem wit="#Ac #Ad #Be #Bs #Ga #Gb #Gc #Kb #La #Mb #Mc #Oa #Ob #Od #Ph #Sn">μεγάλου</lem>
                     <rdg wit="#Ve">ὑψηλοῦ</rdg>
                  </app>, καὶ πνεύματι τὸν οὐρανὸν <app type="variants">
                     <lem wit="#Ac #Ad #Be #Bs #Ga #Gb #Gc #Kb #La #Mb #Mc #Oa #Ob #Od #Ph #Ve">
                        <app type="variants">
                           <lem wit="#Ac #Ad #Ga #Gb #Gc #Kb #Oa #Ph #Ve">ὑπερβάντος</lem>
                           <rdg wit="#Be" varSeq="1">ὑπερβάντος</rdg>
                           <rdg wit="#La" varSeq="1" type="illegible"/>
                           <rdg wit="#Be #La" type="deletion" varSeq="2"/>
                           <rdg wit="#Bs #Mb #Mc #Ob #Od" type="omission"/>
                        </app> καὶ τὰς ὑπερκοσμίους
								δυνάμεις</lem>
                     <rdg wit="#Oc #Sn" type="omission" cause="homoiarkton"/>
                  </app>
                  <app type="variants">
                     <rdgGrp>
                        <lem wit="#Ac #Ad #Gb #Gc #Ph #Ve">ὑπεραναβάντος</lem>
                        <rdg wit="La" varSeq="2" type="deletion">ὑπερ<gap reason="illegible" quantity="3" unit="character"/>βάντος</rdg>
                     </rdgGrp>
                     <rdg wit="#Be #Bs #Ga #Kb #Mb #Mc #Oa #Ob #Oc #Od #Sn">ὑπερβάντος</rdg>
                  </app>, καὶ <app type="variants">
                     <lem wit="#Ac #Be #Bs #Gc #Kb #La #Mb #Mc #Oa #Ob #Oc #Od #Ph #Ve">ἀπ’</lem>
                     <rdg wit="#Ad #Ga #Gb #Sn">ἐπ’</rdg>
                  </app></p>
