            <level4 id="kr_118_0010_0010_0010" type="列傳">
                <front>
                    <biblioData>
                        <title>
                            <mainTitle>조준의 관력과 성향</mainTitle>
                        </title>
                    </biblioData>
                    <illustGroup>
                        <illustration begin="kr_118_0001" end="kr_118_0005">
                            <caption>국사편찬위원회 소장본(KO21658)</caption>
                        </illustration>
                        <illustration begin="kr_118_0073" end="kr_118_0077">
                            <caption>국사편찬위원회 소장본(KO21644)</caption>
                        </illustration>
