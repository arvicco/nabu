<body>
<div xml:id="cordova-arte2">
<div xml:id="cordova-arte2.1">
<p>
                  <pb break="yes" type="arte" n="1v"/>
                  <pb break="yes" type="pdf" facs="http://archive.org/stream/arteenlenguazapo00juan#page/n19/mode/1up"/>
                  <fw type="head" place="top-center">
                     <hi rend="bold">ARTE</hi>
                  </fw>

                  <lb/>ni tienen terminaciones ni
                  <choice><orig>articulos</orig><reg type="spanish">artículos</reg></choice>
                  como los del
                  <lb/><choice><orig>Latin</orig><reg type="spanish">Latín</reg></choice>,
                  ni tampoco directamente tienen
                  <choice><orig>caſos</orig><reg type="spanish">casos</reg></choice>
                  co<pc type="hyphen">-</pc><lb break="no"/>mo los
                  <choice><orig>nueſtros</orig><reg type="spanish">nuestros</reg></choice>.
                  Sino <choice><orig>añadiendoles</orig><reg type="spanish">añadiéndoles</reg></choice>
                  algunas <choice><orig>parti<pc type="hyphen">-</pc>
                  <lb break="no"/>culas</orig><reg type="spanish">partículas</reg></choice>,
                  o anteponiendo o
                  <choice><orig>poſtponiendo</orig>
                     <reg type="spanish">posponiendo</reg></choice>
                  el
                  <choice><orig>nõbre</orig>
                     <reg type="spanish">nombre</reg></choice> o
                  <lb/>por circunloquios
                  <choice><orig>paſſan</orig>
                     <reg type="spanish">pasan</reg></choice>
                  con ellos por los
                  <choice><orig>caſos</orig>
                     <reg type="spanish">casos</reg></choice>.
                  <lb/>Para cuyo
                  <choice><orig>exēplo</orig>
                     <reg type="spanish">ejemplo</reg></choice>
                  nos
                  <choice><orig>parecio</orig>
                     <reg type="spanish">pareció</reg></choice>
                  declinar
                  <choice><orig>aqui</orig>
                     <reg type="spanish">aquí</reg></choice>
                  <choice><orig>vn</orig>
                     <reg type="spanish">un</reg></choice>
                  <choice><orig>nõ
                  <lb break="no"/>bre</orig><reg type="spanish">nombre</reg></choice>, como para modelo de los
                  <choice><orig>demas</orig><reg type="spanish">demás</reg></choice>,
                  porque todos
                  <lb/>van por aquel camino.
               </p>
               <p>
                  <hi rend="bold">REGLA.</hi>
                  <pc>¶</pc><choice><orig>Dezimos</orig><reg type="spanish">Decimos</reg></choice>
                  que no tienen
                  <choice><orig>articulos</orig><reg type="spanish">artículos</reg></choice>,
                  <lb/>y es, que para ninguna
                  <choice><orig>coſa</orig><reg type="spanish">cosa</reg></choice> inanimada le
                  <choice><orig>ay</orig><reg type="spanish">hay</reg></choice>. Y pa<pc type="hyphen">-</pc><lb break="no"/>ra las criaturas animadas no tienen
                  <choice><orig>mas</orig><reg type="spanish">más</reg></choice>
                  que
                  <choice><orig>eſte</orig><reg type="spanish">este</reg></choice>.
                  <lb/><foreign xml:lang="lat"><choice><abbr>V.g.</abbr><expan>verbi gratia</expan></choice></foreign>
                  <foreign xml:lang="cvz" xml:id="arte2.01_01">gönná</foreign>,
                  <choice><orig>poſtpueſto</orig><reg type="spanish">pospuesto</reg></choice>
                  para todas las hembras, y
                  <lb/><foreign xml:lang="cvz" xml:id="arte2.01_02">niguijo</foreign>,
                  para todos los machos.
                  <foreign xml:lang="lat">Vt</foreign>
                  <foreign xml:lang="cvz" xml:id="arte2.01_03">pénigönná</foreign>
                  <choice><orig>mu<pc type="hypehn">-</pc><lb break="no"/>ger</orig>
                     <reg type="spanish">mu<pc type="hyphen">-</pc><lb break="no"/>jer</reg></choice>,
                  <foreign xml:lang="cvz" xml:id="arte2.01_04">péniniguijo</foreign>,
                  <choice><orig>hõbre</orig><reg type="spanish">hombre</reg></choice>,
                  <foreign xml:lang="cvz" xml:id="arte2.01_05">mänigónná</foreign>,
                  animal hem<pc type="hyphen">-</pc><lb break="no"/>bra,
                  <foreign xml:lang="cvz" xml:id="arte2.01_06">maniniguijo</foreign>,
                  animal macho.
               </p>
            </div>
            <div xml:id="cordova-arte2.2" part="N" org="uniform" sample="complete">
               <head type="cordova"><hi rend="bold"><choice><orig>DECLINACION</orig><reg type="spanish">DECLINACIÓN</reg></choice>.</hi></head>
               <head type="outline">Declinación</head>
               <div xml:id="cordova-arte2.2.1">
                  <head type="outline">[Nominativo]</head>
                  <p><c rend="large">D</c>Eclinemos
                     <choice><orig>agora</orig>
                        <reg type="spanish">ahora</reg></choice>
                     <choice><orig>eſte</orig>
                        <reg type="spanish">este</reg></choice> nombre,
                     <foreign xml:lang="cvz" xml:id="arte2.2.1_1">pichína</foreign>
                     <choice><orig>q̃</orig>
                        <reg type="spanish">que</reg></choice>
                     quie<lb break="no"/>re
                     <choice><orig>dezir</orig>
                        <reg type="spanish">decir</reg></choice>
                     Venado o
                     <choice><orig>Cieruo</orig>
                        <reg type="spanish">Ciervo</reg></choice>,
                     pues
                     <choice><orig>dize</orig>
                        <reg type="spanish">dice</reg></choice>
                     <choice><orig>aſsi</orig><reg type="spanish">así</reg></choice>.
                     <choice><orig>No<pc type="hyphen">-</pc><lb break="no"/>minatiuo</orig><reg type="spanish">Nominativo</reg></choice>
                     <foreign xml:lang="cvz" xml:id="arte2.2.1_2">pichina</foreign>,
                     en <choice><orig>eſte</orig>
                        <reg type="spanish">este</reg></choice>
                     <choice><orig>caſo</orig>
                        <reg type="spanish">caso</reg></choice> no
                     <choice><orig>ay</orig>
                        <reg type="spanish">hay</reg></choice>
                     <choice><orig>difficul<pc type="hyphen">-</pc><lb break="no"/>tad</orig><reg type="spanish">dificul<pc type="hyphen">-</pc><lb break="no"/>tad</reg></choice>,
                     <choice><orig>porq̃</orig><reg type="spanish">porque</reg></choice> es regular y va
                     <choice><orig>aſsi</orig><reg type="spanish">así</reg></choice> en todos los nombres.
                  </p>
               </div>
               <div xml:id="cordova-arte2.2.2" part="N" org="uniform" sample="complete">
                  <head type="cordova"><hi rend="bold">GENITIVO</hi>.</head>
                  <head type="outline">Genitivo</head>
                  <p>
                     <lb/><pc>¶</pc><choice><orig>Genitiuo</orig><reg type="spanish">Genitivo</reg></choice> del
                     <choice><orig>cieruo</orig><reg type="spanish">ciervo</reg></choice>.
                     A <choice><orig>eſte</orig><reg type="spanish">este</reg></choice> le
                     <choice><orig>anteponē</orig><reg type="spanish">anteponen</reg></choice>
                     <choice><orig>vn</orig><reg type="spanish">un</reg></choice>
                     pro<lb break="no"/>nombre para le
                     <choice><orig>hazer</orig><reg type="spanish">hacer</reg></choice>
                     <choice><orig>genitiuo</orig><reg type="spanish">genitivo</reg></choice>.
                     Que es,
                     <foreign xml:lang="cvz" xml:id="arte2.01_09">xi</foreign>.
                     <foreign xml:lang="lat" ana="vel"><choice><abbr>l</abbr><expan>vel</expan></choice></foreign>.
                     <foreign xml:lang="cvz" xml:id="arte2.01_010">xiténi</foreign>.
                     <lb/><foreign xml:lang="lat" ana="vel"><choice><abbr>l</abbr><expan>vel</expan></choice></foreign>.
                     <foreign xml:lang="cvz" xml:id="arte2.01_011">xitíni</foreign>,
                     que quiere
                     <choice><orig>dezir</orig><reg type="spanish">decir</reg></choice>,
                     la parte o lo que pertene<pc type="hyphen">-</pc><lb break="no"/>ce, y
                     <choice><orig>aſsi</orig><reg type="spanish">así</reg></choice>
                     <choice><orig>dizen</orig><reg type="spanish">dicen</reg></choice>,
                     <foreign xml:lang="cvz" xml:id="arte2.01_012">xiténi</foreign>
                     <foreign xml:lang="lat" ana="vel"><choice><abbr>l</abbr><expan>vel</expan></choice></foreign>.
                      <foreign xml:lang="cvz" xml:id="arte2.01_013">xitínipichina</foreign>
                      <foreign xml:lang="lat" ana="vel"><choice><abbr>l</abbr><expan>vel</expan></choice></foreign>.
                      <foreign xml:lang="cvz" xml:id="arte2.01_014">xiquítipi<pc type="hyphen">-</pc><lb break="no"/>china</foreign>,
                     el cuero de venado.
                     <choice><orig>Dizē</orig><reg type="spanish">Dicen</reg></choice>
                     <choice><orig>tãbien</orig><reg type="spanish">también</reg></choice>
                     <foreign xml:lang="cvz" xml:id="arte2.01_015">xäbaya</foreign>.
                     <foreign xml:lang="lat" ana="vel"><choice><abbr>l</abbr><expan>vel</expan></choice></foreign>,
                     <foreign xml:lang="cvz" xml:id="arte2.01_016">xi<lb break="no"/>xabaya</foreign>, mi
                     <choice><orig>māta</orig><reg type="spanish">manta</reg></choice>, <!-- orig mata is obscured, need to encode that later. bdl -->
                     <foreign xml:lang="cvz" xml:id="arte2.01_017">xabalo</foreign>,
                     <foreign xml:lang="cvz" xml:id="arte2.01_018">xábani</foreign>,
                     tu <choice><orig>māta</orig><reg type="spanish">manta</reg></choice>, la de
                     <choice><orig>aq̃l</orig><reg type="spanish">aquel</reg></choice>.
                     <fw type="catchword">
                        <choice><orig>Tambien</orig><reg type="spanish">También</reg></choice>
                     </fw>

                     <pb break="yes" type="arte" n="2r"/>
                     <pb break="yes" type="pdf" facs="http://archive.org/stream/arteenlenguazapo00juan#page/2/mode/1up"/>
                     <fw type="head" place="top-center"><hi rend="bold"> ZAPOTECA</hi></fw>
                     <fw type="pageNum" place="top-right">2</fw>
                     <lb/><choice><orig>Tambien</orig><reg type="spanish">También</reg></choice>
                     <choice><orig>dizen</orig><reg type="spanish">dicen</reg></choice>,
                     <foreign xml:lang="cvz">pénihuaxábanj</foreign>,
                     el hombre cuya es
                     <lb/>la manta, todos
                     <choice><orig>ſon</orig><reg type="spanish">son</reg></choice> romances de
                     <choice><orig>genitiuo</orig><reg type="spanish">genitivo</reg></choice>.
                     <choice><orig>Tābien</orig><reg type="spanish">También</reg></choice>
                     <lb/><choice><orig>eſte</orig><reg type="spanish">este</reg></choice>
                     <foreign xml:lang="cvz">xábaya</foreign>,
                     <foreign xml:lang="cvz">xábalo</foreign>,
                     es nombre
                     <choice><orig>poſeſiuo</orig><reg type="spanish">posesivo</reg></choice>,
                     <foreign xml:lang="lat">vide</foreign> los
                     <lb/>nombres <choice><orig>poſeſsiuos</orig><reg type="spanish">posesivos</reg></choice>. <!-- Future CF bdl -->
                  </p>
               </div>
               <div xml:id="cordova-arte2.2.3">
                  <head type="cordova">DATIVO.</head>
                  <head type="outline">Dativo</head>
                  <p><pc>¶</pc><choice><orig>Datiuo</orig><reg type="spanish">Dativo</reg></choice> al
                     <choice><orig>cieruo</orig><reg type="spanish">ciervo</reg></choice>, para
                     <choice><orig>vſar</orig><reg type="spanish">usar</reg></choice>
                     <choice><orig>deſte</orig>
                        <reg type="spanish">este</reg></choice> no
                     <choice><orig>hazen</orig><reg type="spanish">hacen</reg></choice> <choice><orig>mas</orig>
                   <reg type="spanish">más</reg></choice>
                     <lb/>que <choice><orig>poſtponer</orig><reg type="spanish">posponer</reg></choice> el
                     <choice><orig>datiuo</orig><reg type="spanish">dativo</reg></choice>.
                     <foreign xml:lang="lat" ana="vt">vt</foreign>.
                     Dile a Pedro los tomi<pc type="hyphen">-</pc><lb break="no"/>nes,
                     <foreign xml:lang="cvz" xml:id="arte2.01_019">péea tomines Pedro</foreign>,
                     dile del pan al <choice><orig>cieruo</orig><reg type="spanish">ciervo</reg></choice>,<lb break="no"/> <foreign xml:lang="cvz" xml:id="arte2.01_020">péeaqueta pichína</foreign>.
                     <choice><orig>Dizen</orig><reg type="spanish">Dicen</reg></choice>
                     <choice><orig>tambien</orig><reg type="spanish">también</reg></choice>,
                     <choice><orig>apiadate</orig><reg type="spanish">apiádate</reg></choice> de
                     <lb/><choice><orig>mi</orig><reg type="spanish">mí</reg></choice>,
                     <foreign xml:lang="cvz" xml:id="arte2.01_021">pechijcícaláchinaa</foreign>,
                     <choice><orig>oſey</orig><reg type="spanish">o sé</reg></choice> <choice><orig>manſo</orig><reg type="spanish">manso</reg></choice> para
                     <choice><orig>comigo</orig><reg type="spanish">conmigo</reg></choice>.
                  </p>
               </div>
               <div xml:id="cordova-arte2.2.4">
                  <head type="cordova"><choice><orig>ACVSATIVO</orig><reg type="spanish">ACUSATIVO</reg></choice>.</head>
                  <head type="outline">Acusativo</head>
                  <p><pc>¶</pc><choice><orig>Acuſatiuo</orig><reg type="spanish">Acusativo</reg></choice>,
                     al <choice><orig>cieruo</orig><reg type="spanish">ciervo</reg></choice>.
                     A <choice><orig>eſte</orig><reg type="spanish">este</reg></choice>
                     <choice><orig>quando</orig><reg type="spanish">cuando</reg></choice>
                     es la <choice><orig>per<pc type="hyphen">-</pc><lb break="no"/>ſona</orig>
                        <reg type="spanish">per<pc type="hyphen">-</pc><lb break="no"/>sona</reg></choice>
                     que padece, no <choice><orig>hazen</orig><reg type="spanish">hacen</reg></choice>
                     <choice><orig>mas</orig><reg type="spanish">más</reg></choice> que
                     <choice><orig>poſtponer</orig><reg type="spanish">posponer</reg></choice><pc type="hyphen">-</pc><lb break="no"/>la,
                     <foreign xml:lang="lat" ana="vt">vt</foreign>
                     para <choice><orig>dezir</orig><reg type="spanish">decir</reg></choice>
                     <choice><orig>mate</orig><reg type="spanish">maté</reg></choice> el <choice><orig>Cieruo</orig><reg type="spanish">Ciervo</reg></choice>
                     <choice><orig>dizen</orig><reg type="spanish">dicen</reg></choice>,
                     <foreign xml:lang="cvz" xml:id="arte2.01_022">pétiapi<pc type="hyphen">-</pc><lb break="no"/>china</foreign>.
                     Y <choice><orig>quando</orig><reg type="spanish">cuando</reg></choice>
                     <choice><orig>ſignifica</orig><reg type="spanish">significa</reg></choice>
                     <foreign xml:lang="lat" ana="none">locum adquem</foreign>
                     <choice><orig>tambien</orig><reg type="spanish">también</reg></choice>
                     <lb/>le <choice><orig>poſtponen</orig><reg type="spanish">posponen</reg></choice>
                     <choice><orig>anteponiendole</orig><reg type="spanish">anteponiéndole</reg></choice>
                     <choice><orig>vna</orig><reg type="spanish">una</reg></choice>
                     <choice><orig>prespoſicion</orig><reg type="spanish">preposición</reg></choice>.
                     <foreign xml:lang="lat" ana="scilicet">ſ</foreign>.
                     <lb/><foreign xml:lang="cvz" xml:id="arte2.01_023">Láo</foreign>,
                     <foreign xml:lang="lat" ana="vt">vt</foreign> vamos al <choice><orig>cieruo</orig><reg type="spanish">ciervo</reg></choice>,
                     <foreign xml:lang="cvz" xml:id="arte2.01_024">cháonoláopichína</foreign>.
                     <choice><orig>Tam<lb break="no"/>bien</orig><reg type="spanish">Tam<lb break="no"/>bién</reg></choice> otras
                     <choice><orig>vezes</orig>
                        <reg type="spanish">veces</reg></choice>
                     <choice><orig>ſe</orig>
                        <reg type="spanish">se</reg></choice>
                     <choice><orig>dize</orig>
                        <reg type="spanish">dice</reg></choice>
                     <choice><orig>ſin</orig>
                        <reg type="spanish">sin</reg></choice>
                     <choice><orig>prepoſicion</orig>
                        <reg type="spanish">preposición</reg></choice>.
                     <foreign xml:lang="lat" ana="vt">vt</foreign>
                     vamos
                     <lb/>a la
                     <choice><orig>ygleſia</orig>
                        <reg type="spanish">iglesia</reg></choice>,
                     <foreign xml:lang="cvz" xml:id="arte2.01_025">cháonoyóhotáo</foreign>,
                     vamos al <choice><orig>rio</orig><reg type="spanish">río</reg></choice>,
                     <foreign xml:lang="cvz" xml:id="arte2.01_026">cháo<pc type="hyphen">-</pc><lb break="no"/>noquígo</foreign>.
                  </p>
               </div>
               <div xml:id="cordova-arte2.2.5">
                  <head type="cordova">VOCATIVO</head>
                  <head type="outline">Vocativo</head>
                  <p><pc>¶</pc><choice><orig>Vocatiuo</orig><reg type="spanish">Vocativo</reg></choice> o
                     <choice><orig>cieruo</orig><reg type="spanish">ciervo</reg></choice>.
                     <choice><orig>Eſte</orig><reg type="spanish">Este</reg></choice> es el
                     <choice><orig>nominatiuo</orig><reg type="spanish">nominativo</reg></choice>
                     <choice><orig>ante<lb break="no"/>pueſto</orig><reg type="spanish">antepuesto</reg></choice>.
                     <foreign xml:lang="cvz" xml:id="arte2.01_027">ha</foreign>,
                     <foreign xml:lang="lat" ana="vt">vt</foreign>
                     <foreign xml:lang="cvz" xml:id="arte2.01_028">ha, pichína</foreign>,
                     o <choice><orig>cieruo</orig><reg type="spanish">ciervo</reg></choice>,
                     o <choice><orig>poſtpueſto</orig><reg type="spanish">pospuesto</reg></choice>,
                     <foreign xml:lang="cvz" xml:id="arte2.01_029">he</foreign>.
                     <lb/><foreign xml:lang="lat" ana="vt">vt</foreign>
                     <foreign xml:lang="cvz" xml:id="arte2.01_030">pichínahe</foreign>.
                  </p>
               </div>
               <div xml:id="cordova-arte2.2.6">
                  <head type="cordova">ABLATIVO.</head>
                  <head type="outline">Ablativo</head>
                  <p><pc>¶</pc><choice><orig>Ablatiuo</orig><reg type="spanish">Ablativo</reg></choice> del
                     <choice><orig>cieruo</orig><reg type="spanish">ciervo</reg></choice>.
                     <choice><orig>Tambien</orig><reg type="spanish">También</reg></choice> carece
                     <choice><orig>eſta</orig><reg type="spanish">esta</reg></choice> len<lb break="no"/>gua
                     <choice><orig>deſte</orig>
                        <reg type="spanish">de este</reg></choice>
                     <choice><orig>caſo</orig>
                        <reg type="spanish">caso</reg></choice>,
                     pero <choice><orig>ſiruenſe</orig>
                        <reg type="spanish">sirvense</reg></choice> los
                     <choice><orig>yndios</orig><reg type="spanish">indios</reg></choice>
                     <choice><orig>del</orig><reg type="spanish">de él</reg></choice>,
                     <choice><orig>deſta</orig><reg type="spanish">de esta</reg></choice>
                     <lb/>manera. O
                     <choice><orig>poſtponiendole</orig><reg type="spanish">posponiéndole</reg></choice> a la
                     <choice><orig>oracion</orig><reg type="spanish">oración</reg></choice> como el

                     <fw type="sig" place="bottom-left">A2</fw>
                     <fw type="catchword" place="bottom-right">acuſatino</fw>
</p>
</div>
</div>
</div>
