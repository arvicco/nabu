            <div xml:id="cordova-arte1.3.1" part="N" org="uniform" sample="complete">
             <head type="outline">Licencia del muy excelente señor Virrey [Don Martín Enriquez].</head>
             <head type="cordova"><choice><orig>L I C E N C I A</orig><reg type="spacing">LICENCIA</reg></choice>
                <choice><orig>D E L</orig><reg type="spacing">DEL</reg></choice>
             <lb/>muy
                <choice><orig>excellente</orig>
                <reg type="spanish">excelente</reg></choice>
                <choice><orig>ſeñor</orig>
                   <reg type="spanish">señor</reg></choice>
             <lb/><choice><orig>Viſorey</orig>
                <reg type="spanish">Virrey</reg></choice>.</head>
            <p>
               <lb/><choice><orig><g ref="#cherub-d">D</g> O N</orig>
                  <reg type="spacing"><g ref="#cherub-d">D</g>ON</reg></choice>
               <choice><orig>M A R T I N</orig>
                  <reg type="spacing">MARTIN</reg>
                  <reg type="spanish">MARTÍN</reg></choice>
               <choice><orig>E N R I<pc type="hyphen">-</pc><lb break="no"/>quez</orig>
                  <reg type="spacing">ENRI<pc type="hyphen">-</pc><lb break="no"/>quez</reg>
               <reg type="spanish">Enri<pc type="hyphen">-</pc><lb break="no"/>quez</reg></choice>,
               <choice><orig>Viſorey</orig>
                  <reg type="spanish">Virrey</reg></choice>,
               <choice><orig>Gouernador</orig>
                  <reg type="spanish">Governador</reg></choice>
               y
               <choice><orig>Ca<lb break="no"/>pitan</orig>
                  <reg type="spanish">Ca<lb break="no"/>pitán</reg></choice>
               General por
               <choice><orig>ſu</orig>
                  <reg type="spanish">su</reg></choice>
               <choice><orig>Mageſtad</orig>
                  <reg type="spanish">Majestad</reg></choice>
               <lb/>en
               <choice><orig>eſta</orig>
                  <reg type="spanish">esta</reg></choice>
               <choice><orig>nueua</orig>
                  <reg type="spanish">nueva</reg></choice>
               <choice><orig>Eſpaña</orig>
                  <reg type="spanish">España</reg></choice>,
               y
               <choice><orig>preſiden<lb break="no"/>te</orig>
                  <reg type="spanish">presiden<lb break="no"/>te</reg></choice>
               de la
               <choice><orig>audiẽcia</orig>
                  <reg type="spanish">audiencia</reg></choice>
               real que en ella
               <lb/><choice><orig>reſide</orig>
                  <reg type="spanish">reside</reg></choice>.
               &amp;c. Por
               <choice><orig>quanto</orig>
                  <reg type="spanish">cuanto</reg></choice>
               por
               par<pc type="hyphen">-</pc><lb break="no"/>te del
               <choice><orig>reuerendo</orig>
                  <reg type="spanish">reverendo</reg></choice>
               padre fray
               <choice><orig>Iuã</orig>
                  <reg type="spanish">Juan</reg></choice>
               <lb/>de
               <choice><orig>Cordoua</orig>
                  <reg type="spanish">Córdoba</reg></choice>,
               de la orden de los
               <lb/>predicadores, me
               <choice><orig>a</orig>
                  <reg type="spanish">ha</reg></choice>
               <choice><orig>ſido</orig>
                  <reg type="spanish">sido</reg></choice>
               <choice><orig>fecha</orig>
                  <reg type="spanish">hecha</reg></choice>
               <choice><orig>relacion</orig>
                  <reg type="spanish">relación</reg></choice>,
               <choice><orig>q̃cõmucho</orig>
                  <reg type="spanish">que con mucho</reg></choice>
               <lb/>trabajo de
               <choice><orig>ſ pũ</orig><reg type="spanish">su puño</reg></choice>,
               y con
               <choice><orig>deſſeo</orig>
                  <reg type="spanish">deseo</reg></choice>
               de
               <choice><orig>aprouechar</orig>
                  <reg type="spanish">aprovechar</reg></choice>
               a los
               na<lb break="no"/>turales, de la
               <choice><orig>nacion</orig>
                  <reg type="spanish">nación</reg></choice>
               <choice><orig>Zapoteca</orig>
                  <reg type="spanish">zapoteca</reg></choice>,
               y que los
               <choice><orig>religioſos</orig>
                  <reg type="spanish">religiosos</reg></choice>
               <lb/>que
               <choice><orig>ſe</orig>
                  <reg type="spanish">se</reg></choice>
               <choice><orig>puſieren</orig>
                  <reg type="spanish">pusieren</reg></choice>
               <choice><orig>a deprender</orig>
                  <reg type="spanish">a aprender</reg></choice>
               la dicha lengua en
               <choice><orig>ſu</orig>
                  <reg type="spanish">su</reg></choice>
               <lb/>modo de hablar, tengan la
               <choice><orig>pulicia</orig><reg type="spanish">pudicia</reg></choice>
               que
               <choice><orig>conuiene</orig>
                  <reg type="spanish">conviene</reg></choice>.
               <choice><orig>A</orig>
                  <reg type="spanish">Ha</reg></choice>
               <lb/><choice><orig>compueſto</orig>
                  <reg type="spanish">compuesto</reg></choice>
               en la dicha lengua
               <choice><orig>vn</orig>
                  <reg type="spanish">un</reg></choice>
               Arte para bien ha<lb break="no"/>blar. El
               <choice><orig>qual</orig>
                  <reg type="spanish">cual</reg></choice>
               para
               <choice><orig>conſeguyr</orig>
                  <reg type="spanish">conseguir</reg></choice>
               el
               <choice><orig>fructo</orig>
                  <reg type="spanish">fruto</reg></choice>
               de
               <choice><orig>ſu</orig>
                  <reg type="spanish">su</reg></choice>
               <choice><orig>deſſeo</orig>
                  <reg type="spanish">deseo</reg></choice>,
               <lb/><choice><orig>querriaſe</orig>
                  <reg type="spanish">quería se</reg></choice>
               <choice><orig>imprimieſſe</orig>
                  <reg type="spanish">imprimiese</reg></choice>,
               <choice><orig>yme</orig>
                  <reg type="spanish">y me</reg></choice>
               <choice><orig>pidio</orig>
                  <reg type="spanish">pidió</reg></choice>
               le
               <choice><orig>diſſe</orig>
                  <reg type="spanish">diese</reg></choice>
               <choice><orig>licẽcia</orig>
                  <reg type="spanish">licencia</reg></choice>
               pa<lb break="no"/>ra ello. Y por mi
               <choice><orig>viſto</orig>
                  <reg type="spanish">visto</reg></choice>
               y atento que
               <choice><orig>eſta</orig>
                  <reg type="spanish">esta</reg></choice>
               <choice><orig>viſto</orig>
                  <reg type="spanish">visto</reg></choice> y
               exa<pc type="hyphen">-</pc><lb break="no"/>minado, por
               <choice><orig>perſonas</orig>
                  <reg type="spanish">personas</reg></choice>
               doctas
               <choice><orig>aquien</orig> <!-- XMFM, this word should be 'a quienes', in order to agree with the plurar 'doctas'  -->
                  <reg type="spanish">a quien</reg></choice>
               lo
               <choice><orig>cometio</orig>
                  <reg type="spanish">cometió</reg></choice>
               el
               <lb/><choice><orig>prouincial</orig>
                  <reg type="spanish">provincial</reg></choice>
               de la dicha orden, y lo
               <choice><orig>aprueuan</orig>
                  <reg type="spanish">aprueban</reg></choice>
               por
               bue<lb break="no"/>no. Y que el
               <choice><orig>reuerendiſsimo</orig>
                  <reg type="spanish">reverendísimo</reg></choice>
               <choice><orig>obiſpo</orig><reg type="spanish">obispo</reg></choice>
               de la ciudad de
               <lb/>Antequera
               <choice><orig>eſta</orig>
                  <reg type="spanish">está</reg></choice>
               de
               <choice><orig>parecerſe</orig>
                  <reg type="spanish">parecer se</reg></choice>
               imprima. Por la
               <choice><orig>pre<pc type="hyphen">-</pc><lb break="no"/>ſente</orig>
                  <reg type="spanish">pre<pc type="hyphen">-</pc><lb break="no"/>sente</reg></choice>
               doy licencia, a
               <choice><orig>qualquier</orig>
                  <reg type="spanish">cualquier</reg></choice>
               <choice><orig>impreſſor</orig>
                  <reg type="spanish">impresor</reg></choice>
               que el
               di<pc type="hyphen">-</pc><lb break="no"/>cho fray
               <choice><orig>Iuan</orig>
                  <reg type="spanish">Juan</reg></choice> de
               <choice><orig>Cordoua</orig>
                  <reg type="spanish">Córdoba</reg></choice>
               <choice><orig>ſeñalare</orig>
                  <reg type="spanish">señalare</reg></choice>,
               para que
               libre<lb break="no"/>mente pueda imprimir
               <choice><orig>eldicho</orig>
                  <reg type="spanish">el dicho</reg></choice>
               Arte, de lengua za<lb break="no"/>poteca,
               <fw type="catchword" place="bottom-right">
                 <hi rend="bold"> † 2 poteca,</hi>
               </fw>
</p>
</div>
</div>
