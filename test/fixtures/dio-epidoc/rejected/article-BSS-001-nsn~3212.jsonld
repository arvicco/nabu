            "schema:hasPart": {
                "@id": "sections\/inscription\/nsn~115693#"
            },
            "schema:description": {
                "@value": "Das in der Inschrift angegebene Datum wird allgemein als Gr\u00fcndungsjahr des Klosters angesehen. Urkundlich belegt ist das urspr\u00fcnglich als \u201eMarienzelle\u201c bezeichnete Kloster erstmals 1146 in einer Urkunde Heinrichs des L\u00f6wen (\u2020 1195), welche die Schenkung des Dorfes Ritdageshvsen an das Kloster vorsieht. Noch 1147 wird das Kloster mitunter als Cella sancte Marie bezeichnet, findet jedoch gleichzeitig bereits die Erw\u00e4hnung als Riddageshusen."
            }
        },
        {
            "@id": "articles\/epi-article\/nsn~3212#object",
            "@type": "crm:E19_Physical_Object",
            "schema:additionalType": {
                "@value": "Bauglied \u203a Portal"
            },
            "schema:location": {
                "@value": "Braunschweig \u203a Riddagshausen \u203a Kloster"
            },
            "schema:description": {
                "@value": "Inschriftenstein am n\u00f6rdlichen Portal der Klostermauer. Die heute nicht mehr erhaltene Inschrift war bereits 1759 stark verwittert und nur noch unvollst\u00e4ndig lesbar."
            },
            "crm:P128_carries": {
                "@id": "sections\/inscription\/nsn~115693#"
            }
        },
