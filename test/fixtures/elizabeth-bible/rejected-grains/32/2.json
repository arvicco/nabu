{
    "translation": "1757 Church Slavonic Elizabeth Bible",
    "abbreviation": "csielizabeth",
    "lang": "cu",
    "language": "Slavonic Elizabeth",
    "direction": "LTR",
    "encoding": "UTF-8",
    "book_nr": 32,
    "book_name": "Jonah",
    "chapter": 2,
    "name": "Jonah 2",
    "verses": [
        {
            "chapter": 2,
            "verse": 1,
            "name": "Jonah 2:1",
            "text": "\u0418 \u043f\u043e\u0432\u0435\u043b\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043a\u0438\u0442\u0443 \u0432\u0435\u043b\u0438\u043a\u043e\u043c\u0443 \u043f\u043e\u0436\u0440\u0435\u0442\u0438 \u0418\u043e\u043d\u0443. \u0418 \u0431\u0435 \u0418\u043e\u043d\u0430 \u0432\u043e \u0447\u0440\u0435\u0432\u0435 \u043a\u0438\u0442\u043e\u0432\u0435 \u0442\u0440\u0438 \u0434\u043d\u0438 \u0438 \u0442\u0440\u0438 \u043d\u043e\u0449\u0438."
        },
        {
            "chapter": 2,
            "verse": 2,
            "name": "Jonah 2:2",
            "text": "\u0418 \u043f\u043e\u043c\u043e\u043b\u0438\u0441\u044f \u0418\u043e\u043d\u0430 \u043a\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0443 \u0411\u043e\u0433\u0443 \u0441\u0432\u043e\u0435\u043c\u0443 \u043e\u0442 \u0447\u0440\u0435\u0432\u0430 \u043a\u0438\u0442\u043e\u0432\u0430"
        },
        {
            "chapter": 2,
            "verse": 3,
            "name": "Jonah 2:3",
            "text": "\u0438 \u0440\u0435\u0447\u0435: \u0432\u043e\u0437\u043e\u043f\u0438\u0445 \u0432 \u0441\u043a\u043e\u0440\u0431\u0438 \u043c\u043e\u0435\u0439 \u043a\u043e \u0413\u043e\u0441\u043f\u043e\u0434\u0443 \u0411\u043e\u0433\u0443 \u043c\u043e\u0435\u043c\u0443, \u0438 \u0443\u0441\u043b\u044b\u0448\u0430 \u043c\u044f \u0438\u0437 \u0447\u0440\u0435\u0432\u0430 \u0430\u0434\u043e\u0432\u0430 \u0432\u043e\u043f\u043b\u044c \u043c\u043e\u0439, \u0443\u0441\u043b\u044b\u0448\u0430\u043b \u0435\u0441\u0438 \u0433\u043b\u0430\u0441 \u043c\u043e\u0439:"
        },
        {
            "chapter": 2,
            "verse": 4,
            "name": "Jonah 2:4",
            "text": "\u043e\u0442\u0432\u0435\u0440\u0433\u043b \u043c\u044f \u0435\u0441\u0438 \u0432\u043e \u0433\u043b\u0443\u0431\u0438\u043d\u044b \u0441\u0435\u0440\u0434\u0446\u0430 \u043c\u043e\u0440\u0441\u043a\u0430\u0433\u043e, \u0438 \u0440\u0435\u043a\u0438 \u043e\u0431\u044b\u0434\u043e\u0448\u0430 \u043c\u044f \u0432\u0441\u044f \u0432\u044b\u0441\u043e\u0442\u044b \u0422\u0432\u043e\u044f \u0438 \u0432\u043e\u043b\u043d\u044b \u0422\u0432\u043e\u044f \u043c\u043d\u0435 \u043f\u0440\u0435\u0438\u0434\u043e\u0448\u0430."
        },
        {
            "chapter": 2,
            "verse": 5,
            "name": "Jonah 2:5",
            "text": "\u0418 \u0430\u0437 \u0440\u0435\u0445: \u043e\u0442\u0440\u0438\u043d\u0443\u0441\u044f \u043e\u0442 \u043e\u0447\u0438\u044e \u0422\u0432\u043e\u0435\u044e: \u0435\u0434\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0443 \u043f\u0440\u0438\u0437\u0440\u0435\u0442\u0438 \u043c\u0438 \u043a\u043e \u0445\u0440\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u043e\u043c\u0443 \u0422\u0432\u043e\u0435\u043c\u0443?"
        },
        {
            "chapter": 2,
            "verse": 6,
            "name": "Jonah 2:6",
            "text": "\u0412\u043e\u0437\u043b\u0438\u044f\u0441\u044f \u043d\u0430 \u043c\u044f \u0432\u043e\u0434\u0430 \u0434\u043e \u0434\u0443\u0448\u0438 \u043c\u043e\u0435\u044f, \u0431\u0435\u0437\u0434\u043d\u0430 \u043e\u0431\u044b\u0434\u0435 \u043c\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f, \u043f\u043e\u043d\u0440\u0435 \u0433\u043b\u0430\u0432\u0430 \u043c\u043e\u044f \u0432 \u0440\u0430\u0437\u0441\u0435\u043b\u0438\u043d\u044b \u0433\u043e\u0440,"
        },
        {
            "chapter": 2,
            "verse": 7,
            "name": "Jonah 2:7",
            "text": "\u0441\u043d\u0438\u0434\u043e\u0445 \u0432 \u0437\u0435\u043c\u043b\u044e, \u0435\u044f\u0436\u0435 \u0432\u0435\u0440\u0435\u0438 \u0435\u044f \u0437\u0430\u043a\u043b\u0435\u043f\u0438 \u0432\u0435\u0447\u043d\u0438\u0438: \u0438 \u0434\u0430 \u0432\u0437\u044b\u0434\u0435\u0442 \u0438\u0437 \u0438\u0441\u0442\u043b\u0435\u043d\u0438\u044f \u0436\u0438\u0432\u043e\u0442 \u043c\u043e\u0439 \u043a \u0422\u0435\u0431\u0435, \u0413\u043e\u0441\u043f\u043e\u0434\u0438 \u0411\u043e\u0436\u0435 \u043c\u043e\u0439."
        },
        {
            "chapter": 2,
            "verse": 8,
            "name": "Jonah 2:8",
            "text": "\u0412\u043d\u0435\u0433\u0434\u0430 \u0441\u043a\u043e\u043d\u0447\u0430\u0432\u0430\u0442\u0438\u0441\u044f \u043e\u0442 \u043c\u0435\u043d\u0435 \u0434\u0443\u0448\u0438 \u043c\u043e\u0435\u0439, \u0413\u043e\u0441\u043f\u043e\u0434\u0430 \u043f\u043e\u043c\u044f\u043d\u0443\u0445, \u0438 \u0434\u0430 \u043f\u0440\u0438\u0438\u0434\u0435\u0442 \u043a \u0422\u0435\u0431\u0435 \u043c\u043e\u043b\u0438\u0442\u0432\u0430 \u043c\u043e\u044f \u043a\u043e \u0445\u0440\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u043e\u043c\u0443 \u0422\u0432\u043e\u0435\u043c\u0443."
        },
        {
            "chapter": 2,
            "verse": 9,
            "name": "Jonah 2:9",
            "text": "\u0425\u0440\u0430\u043d\u044f\u0449\u0438\u0438 \u0441\u0443\u0435\u0442\u043d\u0430\u044f \u0438 \u043b\u043e\u0436\u043d\u0430\u044f \u043c\u0438\u043b\u043e\u0441\u0442\u044c \u0441\u0432\u043e\u044e \u043e\u0441\u0442\u0430\u0432\u0438\u0448\u0430:"
        },
        {
            "chapter": 2,
            "verse": 10,
            "name": "Jonah 2:10",
            "text": "\u0430\u0437 \u0436\u0435 \u0441\u043e \u0433\u043b\u0430\u0441\u043e\u043c \u0445\u0432\u0430\u043b\u0435\u043d\u0438\u044f \u0438 \u0438\u0441\u043f\u043e\u0432\u0435\u0434\u0430\u043d\u0438\u044f \u043f\u043e\u0436\u0440\u0443 \u0422\u0435\u0431\u0435, \u0435\u043b\u0438\u043a\u0430 \u043e\u0431\u0435\u0449\u0430\u0445, \u0432\u043e\u0437\u0434\u0430\u043c \u0422\u0435\u0431\u0435 \u0432\u043e \u0441\u043f\u0430\u0441\u0435\u043d\u0438\u0435 \u043c\u043e\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u0435\u0432\u0438."
        },
        {
            "chapter": 2,
            "verse": 11,
            "name": "Jonah 2:11",
            "text": "\u0418 \u043f\u043e\u0432\u0435\u043b\u0435 \u0413\u043e\u0441\u043f\u043e\u0434\u044c \u043a\u0438\u0442\u043e\u0432\u0438, \u0438 \u0438\u0437\u0432\u0435\u0440\u0436\u0435 \u0418\u043e\u043d\u0443 \u043d\u0430 \u0441\u0443\u0448\u0443. "
        }
    ]
}