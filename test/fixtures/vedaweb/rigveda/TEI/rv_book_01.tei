            <lg xml:id="b01_h001_01_eichler" xml:lang="san-Deva" source="eichler">
              <l xml:id="b01_h001_01_eichler_a">अ॒ग्निमी॑ळे पु॒रोहि॑तं य॒ज्ञस्य॑ दे॒वमृ॒त्विज॑म्</l>
              <l xml:id="b01_h001_01_eichler_c">होता॑रं रत्न॒धात॑मम्</l>
            </lg>
            <lg xml:id="b01_h001_01_geldner" xml:lang="deu" source="geldner">
              <l xml:id="b01_h001_01_geldner_0" xml:lang="deu">Agni berufe ich als Bevollmächtigten, als Gott-Priester des Opfers, als Hotr̥, der am meisten Lohn einbringt.</l>
            </lg>
            <lg xml:id="b01_h001_01_grassmann" xml:lang="deu" source="grassmann">
              <l xml:id="b01_h001_01_grassmann_0" xml:lang="deu">Den Priester Agni preise ich, der nach der Ordnung Opfer bringt, Den Gott, den schatzverleihendsten,</l>
            </lg>
            <lg xml:id="b01_h001_01_griffith" xml:lang="eng" source="griffith">
              <l xml:id="b01_h001_01_griffith_0" xml:lang="eng">I Laud Agni, the chosen Priest, God, minister of sacrifice, The hotar, lavishest of wealth.</l>
            </lg>
            <lg xml:id="b01_h001_01_macdonell" xml:lang="eng" source="macdonell">
              <l xml:id="b01_h001_01_macdonell_0" xml:lang="eng">Agni I praise, the household priest, God, minister of sacrifice, Invoker, best bestowing wealth.</l>
            </lg>
            <lg xml:id="b01_h001_01_oldenberg" xml:lang="eng" source="oldenberg">
              <l xml:id="b01_h001_01_oldenberg_0" xml:lang="eng">1 I magnify 2 Agni, the Purohita, the divine ministrant of the sacrifice, the Hotri priest, the greatest bestower of treasures.</l>
            </lg>
            <lg xml:id="b01_h001_01_renou" xml:lang="fra" source="renou">
              <l xml:id="b01_h001_01_renou_0" xml:lang="fra">J'invoque Agni (en tant que) préposé (au culte), dieu du sacrifice, officiant,/ oblateur conférant les trésors par excellence.</l>
            </lg>
            <lg xml:id="b01_h001_01_elizarenkova" xml:lang="rus" source="elizarenkova">
              <l xml:id="b01_h001_01_elizarenkova_1">Агни призываю я – во главе поставленного</l>
              <l xml:id="b01_h001_01_elizarenkova_2">Бога жертвы (и) жреца,</l>
              <l xml:id="b01_h001_01_elizarenkova_3">Хотара обильнейшесокровищного.</l>
            </lg>
