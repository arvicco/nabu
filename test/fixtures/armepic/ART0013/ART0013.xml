            <lb n="6" break="no"/><supplied reason="lost">ս</supplied>ի</w></forename></persName>, <w lemma="աղաւթք" pos="NOUN">յաղաւթս</w> <w lemma="յիշել" pos="VERB">յիշեցէք</w>:
          </ab>
