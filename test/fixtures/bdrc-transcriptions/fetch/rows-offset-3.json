{"features":[{"feature_idx":0,"name":"transcription","type":{"dtype":"string","_type":"Value"}},{"feature_idx":1,"name":"id","type":{"dtype":"string","_type":"Value"}},{"feature_idx":2,"name":"mw_id","type":{"dtype":"string","_type":"Value"}},{"feature_idx":3,"name":"technology","type":{"dtype":"string","_type":"Value"}},{"feature_idx":4,"name":"script","type":{"dtype":"string","_type":"Value"}},{"feature_idx":5,"name":"script_4","type":{"dtype":"string","_type":"Value"}},{"feature_idx":6,"name":"image","type":{"_type":"Image"}}],"rows":[{"row_idx":3,"row":{"transcription":"༼ཡེ་ཤེས་༽མ་གཏོགས་མེད་པས་ ༼སྤྱི་བླུག་༽ཉོན་མོངས་པ་འདོད་ཆགས་ལ་སོགས་པའི་རང་རྒྱུད་ལ་ཤོག་གུ་སྣུམ་ཐིག་ཐེབ་པ་ལྟར་བག་ཉལ་ཚུལ་དུ་ཡོད་པས། \nཉོན་མོངས་པ་འདོད་ཆགས་ལྟ་བུ་ཡིན་ན་དེ་ཉིད་སྐྱེ་བའི་རྐྱེན་བུད་མེད་དང་འཕྲད་པའི་དུས་ཉོན་མོངས་པ་འདོད་ཆགས་ཡར་སློང་ནས་མངོན་གྱུར་པ་སྐྱེ་བ་དཔེར་ན་\nབུད་ཤིང་མེ་སྦར་བ་བཞིན། ཉོན་མོངས་པ་ཐམས་ཅད་རང་བཞིན་མ་གྲུབ་པའི་རང་རིག་པའི་ཡེ་ཤེས་སུ་འཆར་བས་ན། ཤིང་ཕུང་ཇི་ཙམ་ཆེ་ཡང་མེ་དཔུང་ཡང་\nདེ་ཙམ་ཆེ་བ་བཞིན་དུ་ཤེས་རབ་སྟོང་པ་ཉིད་བ༡༠༦།༢ ༼ལུས་༽ཤེས་ལ་སྐྱེ་ ༼སེམས་༽ཤེས་ཀྱི་མྱོང་ལུས་སེམས་ ༼གཉིས་བདེ་༽སྟོང་ཡེ་ཤེས་ ༼བྱུང་ཞིང་༽རང་བྱུང་ཡེ་ཤེས་ \n༼ཉིད་༽རང་གིས་བ༡༠༦།༤ ༼དོན་དུ་འང་༽བདེ་སྟོང་ཡེ་ཤེས་ངོས་བཟུང་ཤེས་ན་ ༼དེ་ལྟར་༽ ༼རང་བྱུང་༽ཡེ་ཤེས་ཡིན་ལ། ༼འདི་༽རྣམས་རང་བྱུང་ཡེ་ཤེས་རྟེན་ཤེས་རབ་མ་ལ་བརྟེན་\nནས་བདེ་སྟོང་གི་ཡེ་ཤེས་ནི། དཔེར་ན་མེ་ལ་ཤིང་བསྣན་ན་སྔར་མའི་མེ་ཇེ་ཆེར་བྱུང་བ་ལྟར་ཡེ་ནས་རང་བྱུང་ཡེ་ཤེས་ཡོད་པས། བ༡༠༦།༤ ༼དེ་ཡི་ཕྱིར་ཡེ་ཤེས་༽","id":"202604:Kurt:IE8LS16909_MA:VE8LS16920_MA:v2:I8LS169200242.jpg","mw_id":"MW8LS16909","technology":"manuscript","script":"ume","script_4":"danyig_pedri","image":{"src":"https://datasets-server.huggingface.co/cached-assets/BDRC/berkeley-transcriptions/--/ed7b6318146f00b48c01f5f15b7425ad3269489f/--/default/train/3/image/image.jpg?Expires=TRIMMED","height":547,"width":2450}},"truncated_cells":[]},{"row_idx":4,"row":{"transcription":"བུ་སྟ་གྲི་ཞགས་པ་བཟུང་༔ཆུང་སྲི་མི་ཟན་འདྲེ་རུ་རྫུས༔བྱིས་པ་ཆུང་དར་གཞོན་གསུམ་གཤེད༔མི་ནོར་ཆུང་ངུའི་སྲོག་གི་བདུད༔\nཟ་འདྲེ་དབུགས་ལེན་སྐྱེ་རྒྱུད་བཅད༔འཁོར་དུ་གདོན་ཆེན་བཅོ་ལྔ་དང༔འབྲོག་མ་མ་བུ་ལྔ་བརྒྱ་དང་༔ཡི་དྭགས་བགེགས་རིགས་\nབརྒྱད་ཁྲིས་བསྐོར༔མི་སྐྱེ་བ་ལ་སྐྱེ་བ་བྱེད༔སྐྱེ་བ་ཆུང་སྲི་ཟས་སུ་ཟ༔ཡ་མ་ནག་པོའི་རྒྱུད་པ་བཅས༔དེ་བས་ཆུང་སྲི་\nགནོད་བྱེད་ཁྱོད༔བདག་དང་རྒྱུ་སྦྱོར་ཡོན་བདག་གིས༔མདོས་རྫས་འདི་ལ་འདུས་ཏེ་ཤོག༔ངུ་ཏྲི་སུ་རྣྲི་པྲེ་ཏ་ས་མ་ཡ་ཛ༔\nཞེས་ཀྱི་དྲི་གསུང་བཏང་ལ་སྦྱིན་རྫས་བསྔོ་བ་ནི༔༔ཀྱཻ༔གནོད་བྱེད་ཆུང་སྲི་ནག་པོ་ཁྱོད༔སྔོན་ཚེ་སྐྱེ་བ་དང་པོ་ནི༔མ་རིག་འདྲེ་ངན་\nགཟུགས་སུ་གྲུབ༔བསྭེ་རག་ཡི་དྭགས་ལུས་བླང་ནས༔གཅེར་བུ་མགོ་གསུམ་དམ་སྲི་གྱུར༔བཤལ་གྲི་ཞགས་པ་ནག་པོ་མཐོང་༔","id":"202604:Kurt:IE30498_MA:VE1CZ4792_MA:v2:I1CZ47920484.tif","mw_id":"MW30498","technology":"manuscript","script":"ume","script_4":"druma","image":{"src":"https://datasets-server.huggingface.co/cached-assets/BDRC/berkeley-transcriptions/--/ed7b6318146f00b48c01f5f15b7425ad3269489f/--/default/train/4/image/image.jpg?Expires=TRIMMED","height":2240,"width":10528}},"truncated_cells":[]},{"row_idx":5,"row":{"transcription":"མེད་པ་དབྱིངས་རིག་གི་སྣང་བ། །ཆེས་ཆེར་འཕེལ་ནས་ཉམས་སྣང་གོང་འཕེལ་དུ་འགྱུར་ཞིང་། །འོད་ལྔའི་དཀྱིལ་འཁོར་ཡིག་འབྲུ་ཕྱག་\nམཚན་དང་ལྷ་སྐུ། །སྐུ་ཕྱེད་སྐུ་རྐྱང་ཡབ་ཡུམ་རྒྱན་རྫོགས་དང་རིགས་ལྔ། །ཚད་ཕེབས་སྣང་བ་ཤར་ནས་འཁྲུལ་པ་ཀུན་ཟད་ཅིང་། །རིག་\nཔ་ནང་དབྱིངས་ནུབ་པ་གཞོན་ནུ་ཡི་བུམ་སྐུ། །བོན་ཉིད་ཟད་པ་ཞེས་པའི་ཐ་སྙད་དུ་གདགས་པ། །ཕུང་པོ་འཇའ་ལུས་ཡལ་བ་རྫོགས་\nཆེན་གྱི་ཁྱད་ཆོས། །ཉམས་ལེན་མཐའ་འཁྱོལ་མཛད་པ་བཀའ་དྲིན་ནི་ཆེའོ། །དོན་དམ་སངས་རྒྱས་དགོངས་པ་རང་ན་ཡང་ཤར་ཀྱང་། \n།ཀུན་རྫོབ་སྣང་བར་ཤར་བའི་བསྟན་འགྲོ་ཡི་དོན་ལ། །ངལ་བ་མེད་པར་ཐུགས་རྗེ་རྒྱུན་དུ་ཡང་བསྲིངས་ཞིང་། །ཐབས་མཁས་མཛད་པས་","id":"202604:Kurt:IE30498_MA:VE1CZ4824_MA:v2:I1CZ48240174.tif","mw_id":"MW30498","technology":"manuscript","script":"ume","script_4":"danyig_pedri","image":{"src":"https://datasets-server.huggingface.co/cached-assets/BDRC/berkeley-transcriptions/--/ed7b6318146f00b48c01f5f15b7425ad3269489f/--/default/train/5/image/image.jpg?Expires=TRIMMED","height":2240,"width":10528}},"truncated_cells":[]}],"num_rows_total":6,"num_rows_per_page":100,"partial":false}
