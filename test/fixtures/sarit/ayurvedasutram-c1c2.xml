    <text xml:id="āyurvedasūtram" xml:lang="sa-Latn">
        <body xml:lang="sa-Latn">
            <head xml:lang="en"><title>The Ayurvedasūtram, chapters 1-5 [a machine-readable
                    transcription by Zoe Slatoff]</title></head>
            <div n="1" type="chapter">
                <head xml:lang="en">Chapter 1</head>
                <list>
                    <label xml:lang="en">1.1</label>
                    <item>athāto dhātusthadoṣagatyavikārahetubhūtārthavārdhakadravyāṇyadyāt</item>
                    <label xml:lang="en">1.2</label>
                    <item>cirāyuricchāpravṛttirāyurvedārthapuruṣārthopapādikā</item>
                    <label xml:lang="en">1.3</label>
                    <item>taddhetubhūtārthaṃ rakṣet</item>
                </list>
            </div>
            <div n="2" type="chapter">
                <head xml:lang="en">Chapter 2</head>
                <list>
                    <label xml:lang="en">2.1</label>
                    <item>dvirasārtharasahīnārthahīnarasavānanilanivārakaḥ</item>
                    <label xml:lang="en">2.2</label>
                    <item>ṣaṭsahasratriṃśatsirāstriṃśacchalyāśśatadvayadaśottarasandhayo
                        navāśītisnāyupeśidharā bhavanti</item>
                </list>
            </div>
        </body>
    </text>
