                                                                      <lb ed="ms" n="22"/><w me:msa="xNC nS gM cG sI" lemma="fundr" xml:id="w1300"><me:dipl>fun<ex>n</ex>dar</me:dipl></w>
                                                                      <w me:msa="xCS " lemma="sem" xml:id="w1400"><me:dipl>sæm</me:dipl></w>
                                                                      <lb ed="ms" n="23"/><w me:msa="xVB p3 nS tPS mIN vA" lemma="byria" xml:id="w1500"><me:dipl>byriar</me:dipl></w><lb n="1" ed="H-O"/>
