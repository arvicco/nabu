  <text>
     <body>
        <pb n="1" facs="#rara-fmg-artot-de-padilla-d-001_0001"/>
        <div type="letter">
           <opener>
               <dateline> 
                  <date>Vendredi 6 heures</date>
               </dateline>
               <lb/>
              <lb/>Mon cher <rs type="person" ref="#Pietsch_Ludwig">Pietsch</rs>,
           </opener>
            <p>
               <lb/>je rentre et trouve 
               <lb/>du changement - figurez
               <lb/>vous que <rs type="person" ref="#Baugniet_Charles" cert="medium" resp="#VH">mon oncle</rs>
               <lb/>n'ayant pas vue votre
               <lb/>lettre ainsi qu'il en
               <lb/>était convenu, ne comptait
               <lb/>plus sur le plaisir de
               <lb/>vous voir demain avec
               <lb/>vos chers amis – il a donc
               <lb/>pendant mon absence              
            </p>
           <pb n="2" facs="#rara-fmg-artot-de-padilla-d-001_0002"/>
           <p>
              <lb/><add resp="#Unbekannt_0057"><rs type="person" ref="#Kalbeck_Max">Max Kalbeck</rs></add>
           </p>
           <pb n="3" facs="#rara-fmg-artot-de-padilla-d-001_0003"/>
           <p>
              <lb/>invité quatre personnes
              <lb/>ce qui fait que nous
              <lb/>n’avions plus place à
              <lb/>table – priez donc M<hi rend="underline" n="2"><hi rend="sup">r</hi></hi> <rs type="person" ref="#Preuss">
              <lb/>Preuss</rs>, M<hi rend="underline" n="2"><hi rend="sup">me</hi></hi><rs type="person" ref="#Menzel_Emilie" cert="low" resp="#VH">Menzell</rs>
              <lb/>et peut être le cher
              <lb/><rs type="person" ref="#Unbekannt_0056">peintre</rs> de vous
              <lb/>accompagner et faites
              <lb/>nous l’amitié de venir
              <lb/>diner avec nous Dimanche
              <lb/>en petit et bon comité.
           </p>
           <pb n="4" facs="#rara-fmg-artot-de-padilla-d-001_0004"/>
           <p>
              <lb/>Je vous <gap reason="illegible" unit="word" quantity="1" resp="#VH"></gap>
              <lb/>ceci en toute hâte  
              <lb/>donc á Dimanche.
           </p>
           <closer>
               <salute>Mille amitiés</salute>
               <lb/><signed><hi rend="underline"><rs type="person" ref="#Artot_de_Padilla_Desiree">D. Artot</rs></hi></signed>
               <lb/>
            </closer> 
        </div>
      </body>
  </text>
