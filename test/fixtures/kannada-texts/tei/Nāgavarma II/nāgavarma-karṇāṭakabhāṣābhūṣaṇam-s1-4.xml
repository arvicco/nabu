    <body>
      <head>karṇāṭakabhāṣābhūṣaṇaṁ</head>
      <lg met="anuṣṭubh">
	<l>sarvajñaṁ tad ahaṁ vandē parajyōtis tamōpaham</l>
	<l>pravr̥ttā yanmukhād dēvī sarvabhāṣāsarasvatī</l>
      </lg>
      <div type="section" n="1">
	<head>saṁjñāvidhānaṁ</head>
        <div type="sūtra" n="1">
          <ab type="sūtra">atha karṇāṭaka-śabda-siddhiḥ</ab>
          <p>
            <s>atha śabdō ’yam ādau māṅgalyārthaḥ.</s>
            <s>māṅgalyādīni śāstrāṇi pradanta iti prasiddhēḥ.</s>
            <s>adhikārārthō vā.</s>
            <s>mayā karṇāṭa-viṣaya-śabda-siddhir adhikriyata ity arthaḥ.</s>
          </p>
        </div>
        <div type="sūtra" n="2">
          <ab type="sūtra">akārādayaḥ prasiddhā varṇāḥ.</ab>
          <p>
            <s>akārādayō varṇā hakāra-paryavasānāḥ prasiddhā eva vēditavyāḥ.</s>
            <s>tēṣām anādi-kāla-prasiddhatvād anyathā nōpadēṣṭavyāḥ.</s>
          </p>
        </div>
        <div type="sūtra" n="3">
          <ab type="sūtra">tēṣv ādau caturdaśa svarāḥ.</ab>
          <p>
            <s>tēṣv akārādiṣu varṇēṣv ādau caturdaśa-vyavasthitāś caturdaśa-varṇās svara-saṁjñā bhavanti.</s>
            <s>tē kē?</s>
            <s>a ā, i ī, u ū, r̥ r̥ r̥̄, l̥ l̥ l̥̄, ē, ai, ō, au.</s>
          </p>
        </div>
        <div type="sūtra" n="4">
          <ab type="sūtra">ēkadvitrimātrās tē hrasvadīrghaplutāḥ.</ab>
          <p>
            <s>tē iti tacchabdōpādānaṁ vyaktyarthaṁ.</s>
            <s>akārādisvaravyaktyau yē varṇā ēkadvitrimātrāḥ tē khalu yathāsaṅkhyaṁ hrasvadīrghaplutā bhavanti.</s>
          </p>
          <list type="examples" xml:lang="kan-Latn">
            <item>a</item>
            <item>ā</item>
            <item>ā3</item>
          </list>
          <list type="examples" xml:lang="kan-Latn">
            <item>i</item>
            <item>ī</item>
            <item>ī3</item>
          </list>
	  <p>
	    <s>ity ādi.</s>
	  </p>
	  <p>
	    <s>sāmānyāpēkṣayā saṅkhyāpi na virudhyatē.</s>
	  </p>
        </div>
      </div>
    </body>
  </text>
