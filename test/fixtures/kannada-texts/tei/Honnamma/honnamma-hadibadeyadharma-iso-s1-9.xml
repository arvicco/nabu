  <text xml:lang="san-Latn">>
    <body>
      <head>saṁciya honnamma viracita<lb/>
      hadibadeya dharma<lb/>
      sāṁgatya</head>
      <div type="sandhi" n="1">
	<head>modalaneya saṁdhi</head>
	<lg n="1">
	  <l>śrīmadamalaguṇanidhige nityanige ni</l>
	  <l>ssīma kr̥pāvāridhige</l>
	  <l>rāmaṇīyakarāśige paścima raṁga</l>
	  <l>dhāmanigāneraguvenu</l>
	</lg>
	<lg n="2">
	  <l>raṁgadhāmana divyāṁga saṁgatiyiṁ</l>
	  <l>maṁgaḷadēvateyenipā</l>
	  <l>raṁgamaṁdira maṁgaḷavaijayaṁtige</l>
	  <l>raṁganāyakigeraguvenu</l>
	</lg>
	<lg n="3">
	  <l>ādinārāyaṇanā śēṣanoḍagūḍi</l>
	  <l>yādaradiṁdavatarise</l>
	  <l>yādavakulavēḷigevetti‍rpudu</l>
	  <l>mēdiniyoḷu maimevaḍedu</l>
	</lg>
      </div>
      <div type="sandhi" n="9">
	<head>oṁbattaneya saṁdhi</head>
	<lg n="1">
	  <l>āvanāṇatiyūḷiga karmayōga ma</l>
	  <l>ttāvana nenahu vijñāna</l>
	  <l>āvanoḷeraka bhakutiyā paravāsu</l>
	  <l>dēvanigāneraguvenu</l>
	</lg>
	<lg n="2">
	  <l>jñāna vairāgya śrīharibhakti satkarma</l>
	  <l>hīnaranemmanāraidu</l>
	  <l>ā nārāyaṇanaḍigeragipa siri</l>
	  <l>gānatigaidu bāḷuvenu</l>
	</lg>
	<lg n="3">
	  <l>patipādabhakteyarenipa satiyaru tā</l>
	  <l>vatiśaya gatigeḷasidoḍe</l>
	  <l>itara ciṁteyanuḷidēkacittadoḷu śrī</l>
	  <l>patipādavane bhajisuvudu</l>
	</lg>
	<lg n="4">
	  <l>āva dēvaranāvaru bhajisuvarā</l>
	  <l>dēvaranavaru sēruvaru</l>
	  <l>āva bhōgadoḷā dēvarirparu tā</l>
	  <l>vā vidhadoḷu bāḷuvaru</l>
	</lg>
	<lg n="5">
	  <l>śrīvaranaḍiya sēridaranuḷida mikka</l>
	  <l>dēvalōkavanēridavaru</l>
	  <l>dēvaroḍane tāvumaḷivareṁbudanu gī</l>
	  <l>tāvacanadoḷu tiḷivudu</l>
	</lg>
	<p>
	  <s>adeṁtene:</s>
	</p>
	<cit>
	  <quote>
	    <lg xml:lang="san-Latn">
	      <label>ślōka</label>
	      <l>ābrahmabhuvanāllōkāḥ</l>
	      <l>punarāvartinō ’rjuna</l>
	      <l>māmupētya tu kauṁtēya</l>
	      <l>punarjanma na vidyatē</l>
	    </lg>
	    <bibl>bhagavadgītā : adhyāya 8, ślōka 16</bibl>
	  </quote>
	</cit>
	<lg n="6">
	  <l>parahiṁseyesagade paradhanakaḷupade</l>
	  <l>parapuraṣaṁgāsevaḍade</l>
	  <l>siriyarasana pādasēvegaidavarā</l>
	  <l>paramapadavanu sēruvaru</l>
	</lg>
	<lg n="7">
	  <l>cāḍivēḷade caṁḍitanavesagade cunna</l>
	  <l>vāḍade jaridu nuḍiyade</l>
	  <l>kēḍeṇisade kelarige haripadasēve</l>
	  <l>gīḍāgi gatiya paḍevudu</l>
	</lg>
      </div>
      <trailer>
	hadibadeya dharma
	saṁpūrṇaṁ
      </trailer>
    </body>
  </text>
