  <text>
    <body>
      <head>pampamahākaviviracitaṁ<lb/>
      ādipurāṇaṁ</head>
      <pb n="3"/>
    <div n="1" type="āśvāsaṁ">
      <head>prathamāśvāsaṁ</head>
      <lg n="1" met="śārdūlavikrīḍitaṁ">
	<l>śrīdēvēndramunīndravanditaguṇavrātaṁ jagatsvāmi saṁ</l>
	<l>dādibrahmanagādhabōdhaniḷayaṁ durvārasaṁsāravi</l>
	<l>cchēdōpāyaniyuktasūktivr̥ṣamārgāgrēsaraṁ pāpahr̥</l>
	<l>tpādābjaṁ dayegeyvanakkemage muktiśrīsukhāvāptiyaṁ</l>
      </lg>
      <lg n="2" met="mahāsragdhare">
	<l>peṇedeṇṭuṁ kilbiṣaṅgaḷkiḍe kiḍada guṇaṁ porde band’ eṇṭum ādaṁ</l>
	<l>taṇivaṁ kaikoṇḍamūrtarcaramatanusamākāraruddhūtalēpar</l>
	<l>praṇutarnityarjaganmaṅgaḷaniḷayaranantartrilōkaikacūḍā</l>
	<l>maṇigaḷsiddhar svakīyaprabhuteyanemagaṁ māḻkatiprītiyindaṁ</l>
      </lg>
      <lg n="3" met="sragdhare">
	<l>mūvattāṟuṁ guṇaṅgaḷtamagamardire sandaidumācāradoḷsa</l>
	<l>dbhāvaṁ kaigaṇme śiṣyācaraṇavidhigaḷaṁ tirdi kāruṇyadindaṁ</l>
	<l>sāvadyaṁ sāradantāgire niyamisuvācāryarinnemmanēnō</l>
	<l>dāvaṁ taḷtaḻvadant’ ōsarisi kaḷege saṁsārakāntāradindaṁ</l>
      </lg>
      <pb n="9"/>
      <lg n="42" met="kandaṁ">
	<l>prāṇihitamaṁ vinēya</l>
	<l>prīṇanakaramaṁ jagattrayaprakaṭitaka</l>
	<l>lyāṇamanī negaḻdādipu</l>
	<l>rāṇamanaparimitabhaktiyiṁ viracisuveṁ</l>
      </lg>
      <p>ā purāṇakkaṁ lōkākārakathanamuṁ dēśanivēśōpadēśamuṁ<lb/>
      nagarasampatparivarṇanamuṁ rājyaramaṇīyatākhyānamuṁ tīrthamahima<lb break="no"/>
      samarthanamuṁ caturgatisvarūpanirūpaṇamuṁ tapōdānavidhānavarṇanamuṁ<lb/>
      tatphaḷaprāptiprakaṭanamum end’ int’ avayavaṅgaḷ’ eṇṭ’ akkuṁ</p>
      <lg n="43" met="mattēbhavikrīḍitaṁ">
	<l>avaṟoḷ lōkam adentuṭendoḍe samantāvaṅgamettetta nō</l>
	<l>ḍuvoḍaṁ nōḍalanantam appa vibhuvappākāśapadmakke tā</l>
	<l>ne valaṁ karṇikeyandamāyt ene viyanmadhyasthamantassthaka</l>
	<l>rmavaśabhrāmyadanēkajīvanivahakrōḍīkr̥tābhyantaraṁ</l>
      </lg>
      <pb n="17"/>
      <lg n="84" met="mattēbhavikrīḍitaṁ">
	<l>laḷitāḷaṅkaraṇaprasannarasavadgēyaṅgaḷoḷ mūḍutuṁ</l>
	<l>muḻuguttuṁ khacarījanānananavāmbhōjaṅgaḷoḷ kampanī</l>
	<l>ḻkoḷutuṁ nandanarājiyoḷnaliyutuṁ tadrājahaṁsaṁ nirā</l>
	<l>kuḷamī māḻkegaḷinde poḻtugaḷevaṁ saṁsārasārōdayaṁ</l>
      </lg>
      <trailer>idu dēvēndramunīndravandyaparamajinēndramukhacandra<lb break="no"/>
      vākcandrikāprasaraprasādōdīrṇasūktikallōlamālākīrṇa<lb break="no"/>
      kavitāguṇārṇavapraṇītamappādipurāṇadoḷ<lb/>
      mahābaḷakumārōdayavarṇanaṁ<lb/>
      prathamāśvāsaṁ</trailer>
    </div>
    <trailer>ādipurāṇaṁ sampūrṇaṁ</trailer>
    </body>
