# sent_id = DVE-1
# text = Cum neminem ante nos de vulgaris eloquentie doctrina quicquam inveniamus tractasse, atque talem scilicet eloquentiam penitus omnibus necessariam videamus - cum ad eam non tantum viri sed etiam mulieres et parvuli nitantur, in quantum natura permictit -, volentes discretionem aliqualiter lucidare illorum qui tanquam ceci ambulant per plateas, plerunque anteriora posteriora putantes, Verbo aspirante de celis locutioni vulgarium gentium prodesse temptabimus, non solum aquam nostri ingenii ad tantum poculum aurientes, sed, accipiendo vel compilando ab aliis, potiora miscentes, ut exinde potionare possimus dulcissimum ydromellum.
# citation_hierarchy = Liber_Primus,i,Paragraphus_1
