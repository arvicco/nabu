         <div type="entry" xml:id="SRO1">
                        
                            <p>To <persName n="pekeryngewilliam" role="stationer enterer">
                                <forename>William</forename> 
                        <surname>pekerynge</surname>
                                </persName> a ballett Called <title>a Ryse and
                                wake</title> 
                     <seg type="fee" rend="roman-numerals aligned-right"><!--processing: iiijd-->
                        <num type="totalPence" value="4"><!--orig: iiijd-->
                           <num type="pence" value="4">iiij<hi rend="superscript">d</hi> 
                           </num> 
                        </num> 
                     </seg> 
                            </p>
