                    </div>
         <div type="entry" xml:id="SRO4">
                        <p>To <persName n="marshethomas" role="stationer enterer"> 
                     <forename>Thomas</forename>
                            <surname>marshe</surname> 
                  </persName> this boke Called <title>the Rules and Ryghte ample Documentes Towchynge the vse
                            and practise of the commen almanacke <del>ys</del> which ys caled ephemerydes</title>
                            <seg type="fee" rend="roman-numerals aligned-right"><!--processing: iiijd-->
                     <num type="totalPence" value="4"><!--orig: iiijd-->
                        <num type="pence" value="4">iiij<hi rend="superscript">d</hi> 
                        </num> 
                     </num> 
                  </seg> 
                        </p>
               <ab type="metadata">
               <idno type="Liber">A</idno>
               <idno type="SRONumber">4</idno>
               <date type="SortDate" when="1557-07-19"/>
               <date type="Register" notBefore="1557-07-19" notAfter="1558-07-09">19 July 1557 - 9 July 1558</date>
                  <num type="totalEntryPence" value="4"/>
                  
                  <idno type="RegisterRef">Register A, f.22r</idno>
                  <idno type="ArberRef">I. 75</idno>
                  <idno type="RegisterID">TSC-1-D-02-01_1554-1596_0072_f22r</idno>
                  <num type="works" value="1"/>
                  <note type="status" subtype="entered"/>
                  <persName n="cawoodj" role="warden">
                     <forename>J.</forename>
                     <surname>Cawood</surname>
                  </persName>
                  <persName n="walleyj" role="warden">
                     <forename>J.</forename>
                     <surname>Walley</surname>
                  </persName>
                  <persName n="dockwrayt" role="master">
