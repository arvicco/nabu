               <date type="SortDate" when="1557-07-19"/>
               <date type="Register" notBefore="1557-07-19" notAfter="1558-07-09">19 July 1557 - 9 July 1558</date>
                  <num type="totalEntryPence" value="120"/>
                  <note resp="#arber">Arber:  As there are <corr resp="#EW">32</corr>
                        ballads in this list, and the minimum fee was <num>4d</num>., the exact
                        amount should have been <num>10s. 4d.</num>; not <num>10s.</num>  
                  </note>
                  
