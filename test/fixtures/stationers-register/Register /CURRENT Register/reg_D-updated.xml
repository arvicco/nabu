               <num type="totalEntryPence" value="6"/>
               
               <idno type="RegisterRef">Register D, p. 89</idno>
               <idno type="ArberRef">IV. 127</idno>
               <idno type="RegisterID">TSC-1-E-06-03_1620-1645_0098_p89</idno>
