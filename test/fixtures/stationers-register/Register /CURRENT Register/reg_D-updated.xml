         <div type="entry" xml:id="SRO10453">
                  <head rend="left">
                     <persName n="staffordjohn" role="stationer enterer">
                        <forename>John</forename> 
                  <surname>Stafford</surname>
                     </persName>
                  </head>
                  <p>Entred for his Copie vnder the hands of <persName n="wykesdoctor" role="non-stationer">doctor 
                     <surname>Wykes</surname>
               </persName> and <persName n="manmasterwarden" role="stationer">Master <surname>Man</surname> warden</persName> 
                     a booke called <title>Two sermons vpon these texts (viz<hi rend="superscript">t</hi>.) 
                     2. Corinthians. 11 <supplied resp="#arber">[chapter]</supplied>. 28. 
                     Proverbes: 29 <supplied resp="#arber">[chapter]</supplied>. 1. by 
                     <persName n="fennermaster" role="non-stationer">Master <surname>Fenner</surname>
                  </persName>
               </title>
                     
                     <seg type="fee" rend="roman-numerals aligned-right"><!--processing: vjd-->
                        <num type="totalPence" value="6"><!--orig: vjd-->
                           <num type="pence" value="6">vj<hi rend="superscript">d</hi>
                           </num>
                        </num>
                     </seg>
                  </p>
                 
