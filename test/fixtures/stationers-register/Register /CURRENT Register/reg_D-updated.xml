         <div type="entry" xml:id="SRO9195">
                  <head rend="left">
                     <persName n="lambertthomas" role="stationer enterer">
                        <forename>Thomas</forename> 
                        <surname>Lambert</surname>
               </persName>:<lb/>
                     <note resp="#arber">Arber: See III. 354; and <hi rend="italics">p</hi>. 227.</note>
            </head>
                  
                  <p>Entred for his Copies 2. ballads called 
                        <title>
                  <persName n="cupid" role="non-stationer">Cupid</persName>s Whirligig &amp;c</title> and
                     
                        <title>the Welch Infectory of the <choice>
                     <sic>Coods</sic>
                     <unclear>
                        <corr>Goods</corr>
                     </unclear>
                  </choice>
               </title>
                     
                     <seg type="fee" subtype="sum" rend="roman-numerals aligned-right"><!--processing: xijd.-->
                        <num type="totalPence" value="12"><!--orig: xijd.-->
                           <num type="pence" value="12">xij<hi rend="superscript">d</hi>
                           </num> . </num>
                     </seg>
                  </p>
                  <ab type="metadata">
               <idno type="Liber">D</idno>
               <idno type="SRONumber">9195</idno>
               <date type="SortDate" when="1633-12-06"/>
               <date type="Register" when="1633-12-06">6 December 1633</date>
               <num type="totalEntryPence" value="12"/>
               
               <idno type="RegisterRef">Register D, p. 283</idno>
               <idno type="ArberRef">IV. 309</idno>
               <idno type="RegisterID">TSC-1-E-06-03_1620-1645_0282_p283</idno>
               <num type="works" value="2"/>
               <note type="status" subtype="entered"/>
               <persName n="weavere" role="warden">
                  <forename>E.</forename>
                  <surname>Weaver</surname>
               </persName>
               <persName n="aspleyw" role="warden">
                  <forename>W.</forename>
                  <surname>Aspley</surname>
               </persName>
               <persName n="islipa" role="master">
                  <forename>A.</forename>
                  <surname>Islip</surname>
               </persName>
               <note type="status" subtype="incomplete"/>
