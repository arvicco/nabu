         <div type="entry" xml:id="SRO8024">
                  <head rend="left">
                     <persName n="islipmaster" role="stationer enterer">Master <surname>Islip</surname>
                     </persName>
                     <note type="register">
                  <supplied resp="#BH">[<hi rend="italics">vide</hi>page 324]</supplied>
               </note>
               <lb/>
                     <note resp="#arber">Arber: See III., 207, 223, 225, and 276; also <hi rend="italics">p</hi>. 97.</note>
                  </head>
                  <p>Assigned ouer vnto him by <persName n="adamsmistris" role="stationer">mistris <surname>Adams</surname>
                     </persName> and Consent of a full Court holden this Day all her estate in the booke Called <title>
                  <persName n="riders" role="non-stationer">
                        <surname>Riders</surname>
                     </persName> Dictionary</title> being a sixt parte                     
                     <seg type="fee" rend="roman-numerals aligned-right"><!--processing: vjd-->
                        <num type="totalPence" value="6"><!--orig: vjd-->
                           <num type="pence" value="6">vj<hi rend="superscript">d</hi>
                           </num>
                        </num>
                     </seg>
                  </p>
                  <ab type="metadata">
               <idno type="Liber">D</idno>
               <idno type="SRONumber">8024</idno>
               <date type="SortDate" when="1624-11-08"/>
