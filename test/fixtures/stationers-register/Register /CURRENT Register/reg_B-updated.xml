         <div type="entry" xml:id="SRO1679">
                  <head rend="left struck-through">
                     <persName n="dewcegarret" role="stationer enterer">
                        <forename>Garret</forename> 
                        <surname>Dewce</surname>
                     </persName>
                  </head>
                  <p rend="struck-through">Lycenced vnto him <title>A great herball called 
                     <persName n="dodoneus">
                           Dodoneus
                        </persName> 
                     herball</title> /
translated into Englishe by <persName n="lighthenry" role="non-stationer">
                        <forename>Henry</forename> 
                        <surname>Light</surname>
                     </persName> esquire 
                     <hi rend="aligned-right">
                        <note resp="#arber">No sum stated</note>
                     </hi>
                  </p>
