         <div type="entry" xml:id="SRO1688">
                  <head rend="left">
                     <persName n="manthomas" role="stationer enterer">
                        <forename>Thomas</forename> 
                        <surname>man</surname>
                     </persName>.</head>
                  <p>Lycenced vnto him vnder th<supplied resp="#arber">[e h]</supplied>and of <persName n="harrisonmaster" role="stationer">master <surname>Harrison</surname>
                     </persName> vpperwarden / iiij. ballates. viz.</p>
                 
                  <desc rend="left">
                     <persName n="manthomas" role="stationer enterer">
                        <forename>Thomas</forename> 
                        <surname>man</surname>
                     </persName>.</desc>
                  <p>
                     <title>A pretie songe of the Judgement day when death shall
                        fetche all awaie</title> 
                     <seg type="fee" rend="roman-numerals aligned-right"><!--processing: iiijd-->
                        <num type="totalPence" value="4"><!--orig: iiijd-->
                           <num type="pence" value="4">iiij<hi rend="superscript">d</hi>
                           </num>
                        </num>
                     </seg>
                  </p>  
                  
                  <desc rend="left">
                     <persName n="manthomas" role="stationer enterer">
                        <forename>Thomas</forename> 
                        <surname>man</surname>
                     </persName>.</desc>
                  <p>
                     <title>A most <corr>proffitable</corr>patterne to all christian men forwarnynge
                        the day of Judgement</title> 
                     <seg type="fee" rend="roman-numerals aligned-right"><!--processing: iiijd-->
                        <num type="totalPence" value="4"><!--orig: iiijd-->
                           <num type="pence" value="4">iiij<hi rend="superscript">d</hi>
                           </num>
                        </num>
                     </seg>
                  </p>
                  
                  <desc rend="left">
                     <persName n="manthomas" role="stationer enterer">
                        <forename>Thomas</forename> 
                        <surname>man</surname>
                     </persName>.</desc>
                  <p>
                     <title>A godlie exhortacon vnto Englande to repent him of the
                        evill and sinfull waies / shewinge th
                     <supplied resp="#arber">[e]</supplied> 
                     example and distruccon of Jerlm 
                     <note resp="#arber">Arber: ? Jerusalem
                     </note> 
                     and Andwarp</title> 
                     <seg type="fee" rend="roman-numerals aligned-right"><!--processing: iiijd-->
                        <num type="totalPence" value="4"><!--orig: iiijd-->
                           <num type="pence" value="4">iiij<hi rend="superscript">d</hi>
                           </num>
                        </num>
                     </seg>
                  </p>
                  
                  <desc rend="left">
                     <persName n="manthomas" role="stationer enterer">
                        <forename>Thomas</forename> 
                        <surname>man</surname>
                     </persName>.</desc>
                  <p>
                     <title>The lamentacon of a yong <corr>man</corr> confessinge his former lyfe that he hathe led</title> 
                     <seg type="fee" rend="roman-numerals aligned-right"><!--processing: iiijd-->
                        <num type="totalPence" value="4"><!--orig: iiijd-->
                           <num type="pence" value="4">iiij<hi rend="superscript">d</hi>
                           </num>
                        </num>
                     </seg>
                  </p>
                  
