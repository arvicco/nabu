      <body>
         <div type="entry" xml:id="SRO4539">
                  <head rend="left">
                     <persName n="harrisonjohnjohnharrisonesonofmasterthelder"
                         role="stationer enterer">
                        <forename>John</forename> 
                        <surname>harrison</surname>
                        son of Master
                        <persName n="harrisonjohn" role="stationer">
                           <forename>John</forename> 
                           <surname>harrison</surname>
                        </persName>
                        Th<supplied resp="#arber">[e]</supplied>elder.</persName>
                  </head>
                  
                  <p>Entred for his copie vnder the handes of <persName n="pasfeildmaster" role="non-stationer">master
                        <surname>pasfeild</surname>
                     </persName> and the
                     wardens <title>certen sermons preached by <persName n="tirollraffemaster" role="non-stationer">master
                        <forename>Raffe</forename> 
                           <surname>Tiroll</surname>
                        </persName> 
                     </title>
                     
                     <seg type="fee" rend="roman-numerals aligned-right"><!--processing: vjd-->
                        <num type="totalPence" value="6"><!--orig: vjd-->
                           <num type="pence" value="6">vj<hi rend="superscript">d</hi>
                           </num>
                        </num>
                     </seg>
                  </p>
                  <p rend="centred">
                     viz
                  </p>
                  
                     <p> 
                     <title type="part">one sermon vppon. <hi rend="smallcaps">Matthew.</hi> 23. <supplied resp="#arber">[chapter]</supplied> verse 5.                     
                        All their woorkes they doo to be seene of men</title>
                  </p>
                        <list rend="bracketed-right">
                           <item>
                              <title type="part">The charge of the clergie</title>
                           </item>
                           <item>And <title type="part">the crowne of christians</title> 2 sermons
                           </item>
                        </list>
                        
                        
                    
                     <p>
                        <title type="part">A festiuall sermon at pentecost The anointing of
                        <persName n="christ">
                           <surname>christ</surname>
                        </persName> 
                        or christian ointment. <hi rend="smallcaps">John</hi> 2. 20</title>
                  </p>
                     <p>
                        <title>A festival sermon on the natiuitie of <persName n="christ">
                           <surname>
                              christ
                           </surname>
                        </persName>
                     </title>
                     </p>
                     <p>1 <title type="part">
                        <persName n="tymothie">
                           <forename>
                              
                           Tymothie
                           </forename>
                        </persName>. 3. 16. And without controuersie great
                        is the mistery &amp;c</title>
                  </p>
                  
