            <div type="folio">
                
                <div type="other">
                    <head rend="blackletter"> 
                  <hi rend="large">The entrynge of all suche<lb/>
                        Copyes as be lycensed to<lb/> be prynted by the master<lb/> and wardyns of
                        the<lb/> mystery of stacioners</hi> 
                  <lb/> 
                  <hi rend="medium">as foloweth
                        that ys to saye</hi> 
               </head>
                    <div type="entry" xml:id="SRO1">
                        
                            <p>To <persName role="stationer">
                                <forename>William</forename> 
                        <surname>pekerynge</surname>
                                </persName> a ballett called <title>a Ryse and
                                wake</title> 
                     <seg type="fee" rend="roman-numerals aligned-right"><!--processing: iiijd-->
                        <num type="totalPence" value="4"><!--orig: iiijd-->
                           <num type="pence" value="4">iiij<hi rend="superscript">d</hi> 
                           </num> 
                        </num> 
                     </seg> 
                  </p>
                            <p>To <persName role="stationer">
                                <forename>John</forename> 
                        <surname>Daye</surname> 
                     </persName> 
                     <title>a proclamation for bere and ale</title> frome the
                                lorde maiour <seg type="fee" rend="roman-numerals aligned-right"><!--processing: iiijd-->
                        <num type="totalPence" value="4"><!--orig: iiijd-->
                           <num type="pence" value="4">iiij<hi rend="superscript">d</hi> 
                           </num> 
                        </num> 
                     </seg> 
                  </p>
                        
                    <ab type="metadata">
                     <date/>
                     <idno type="RegisterRef">Register A, f.</idno>
                     <idno type="ArberRef">I. 74</idno>
                     <idno type="RegisterID">?</idno>
                     <num type="works" value="0"/>
