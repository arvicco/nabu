#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require_relative "../lib/nabu"

# P44-i1b: at ^C, Open3's internal reader threads die with IOError chatter
# before the CLI's clean Interrupt handler can speak — silence the thread
# diagnostics; the CLI prints the one honest interrupt line itself.
Thread.report_on_exception = false

# Progress must reach a redirected log as it happens: with stdout sent to
# a file, Ruby block-buffers it, and a long sync's stage lines sat 2h in a
# 4K buffer during the ndl-kotenseki index hang.
$stdout.sync = true

Nabu::CLI.start(ARGV)
